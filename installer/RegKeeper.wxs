<!-- RegKeeper MSI (WiX 5). Built by build.ps1, which publishes both exes into $(Pub) first. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="RegKeeper" Manufacturer="RegKeeper" Version="$(Version)" UpgradeCode="5ADA3351-48CB-4023-B736-C41980A4CAF4"
             Scope="perMachine" Language="1049" Codepage="1251" Compressed="yes">
        <SummaryInformation Description="Установщик RegKeeper" Codepage="1251"/>
        <MajorUpgrade DowngradeErrorMessage="Уже установлена более новая версия RegKeeper. Сначала удалите её."/>
        <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
        <Launch Condition="Installed OR VersionNT &gt;= 603" Message="RegKeeper работает на Windows 10 и новее."/>

        <!-- Programs and Features entry -->
        <Icon Id="RegKeeper.ico" SourceFile="..\src\RegKeeper\Assets\RegKeeper.ico"/>
        <Property Id="ARPPRODUCTICON" Value="RegKeeper.ico"/>
        <Property Id="ARPCOMMENTS" Value="Удаление программ, автозагрузка, очистка диска и реестра, твики."/>
        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize"/>

        <!-- a repair or an upgrade goes to the folder picked the first time -->
        <Property Id="INSTALLFOLDER">
            <RegistrySearch Id="PrevFolder" Root="HKLM" Key="Software\RegKeeper\Setup" Name="InstallDir" Type="raw"/>
        </Property>

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="RegKeeper">
                <Directory Id="DataFolder" Name="Data"/>
            </Directory>
        </StandardDirectory>

        <Feature Id="Main" Title="RegKeeper" Description="Программа и её данные (база твиков, перевод)." AllowAbsent="no"
                 ConfigurableDirectory="INSTALLFOLDER" Display="expand">
            <Component Directory="INSTALLFOLDER">
                <File Id="RegKeeperExe" Source="$(Pub)\RegKeeper.exe" KeyPath="yes"/>
            </Component>
            <Component Directory="INSTALLFOLDER">
                <File Source="..\LICENSE" Name="LICENSE.txt" KeyPath="yes"/>
            </Component>
            <!-- the embedded Inter font ships under the SIL OFL, which travels with it -->
            <Component Directory="INSTALLFOLDER">
                <File Source="..\src\RegKeeper\Assets\Fonts\OFL.txt" Name="Inter-OFL.txt" KeyPath="yes"/>
            </Component>
            <Component Directory="INSTALLFOLDER">
                <RegistryValue Root="HKLM" Key="Software\RegKeeper\Setup" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes"/>
            </Component>
            <Files Include="$(Pub)\Data\**" Directory="DataFolder"/>
            <!-- whatever the app itself switched on for this user goes away with it; backups in ProgramData stay for the Undo center -->
            <Component Id="UserCleanup" Directory="INSTALLFOLDER">
                <RegistryValue Root="HKCU" Key="Software\RegKeeper\Setup" Name="Installed" Type="integer" Value="1" KeyPath="yes"/>
                <RemoveRegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="RegKeeper Watcher"/>
                <RemoveRegistryKey Root="HKCU" Key="Software\Classes\exefile\shell\RegKeeperUninstall" Action="removeOnUninstall"/>
                <RemoveRegistryKey Root="HKCU" Key="Software\Classes\lnkfile\shell\RegKeeperUninstall" Action="removeOnUninstall"/>
                <RemoveRegistryKey Root="HKCU" Key="Software\RegKeeper\Setup" Action="removeOnUninstall"/>
            </Component>

            <Feature Id="StartMenu" Title="Ярлык в меню Пуск" Description="RegKeeper в списке программ меню Пуск.">
                <Component Directory="ProgramMenuFolder">
                    <Shortcut Id="StartMenuLnk" Name="RegKeeper" Description="Удаление программ, автозагрузка и чистка реестра"
                              Target="[INSTALLFOLDER]RegKeeper.exe" WorkingDirectory="INSTALLFOLDER"/>
                    <RegistryValue Root="HKCU" Key="Software\RegKeeper\Setup" Name="StartMenu" Type="integer" Value="1" KeyPath="yes"/>
                </Component>
            </Feature>
            <Feature Id="Desktop" Title="Ярлык на рабочем столе" Description="Ярлык RegKeeper на общем рабочем столе.">
                <Component Directory="DesktopFolder">
                    <Shortcut Id="DesktopLnk" Name="RegKeeper" Description="Удаление программ, автозагрузка и чистка реестра"
                              Target="[INSTALLFOLDER]RegKeeper.exe" WorkingDirectory="INSTALLFOLDER"/>
                    <RegistryValue Root="HKCU" Key="Software\RegKeeper\Setup" Name="Desktop" Type="integer" Value="1" KeyPath="yes"/>
                </Component>
            </Feature>
            <Feature Id="ShellVerb" Title="Пункт «Удалить с RegKeeper»" Description="Пункт в контекстном меню exe-файлов и ярлыков. В Windows 11 он в «Показать дополнительные параметры».">
                <Component Directory="INSTALLFOLDER">
                    <RegistryValue Root="HKCU" Key="Software\Classes\exefile\shell\RegKeeperUninstall" Value="Удалить с RegKeeper" Type="string" KeyPath="yes"/>
                    <RegistryValue Root="HKCU" Key="Software\Classes\exefile\shell\RegKeeperUninstall" Name="Icon" Value="[INSTALLFOLDER]RegKeeper.exe" Type="string"/>
                    <RegistryValue Root="HKCU" Key="Software\Classes\exefile\shell\RegKeeperUninstall\command" Value="&quot;[INSTALLFOLDER]RegKeeper.exe&quot; --uninstall &quot;%1&quot;" Type="string"/>
                    <RegistryValue Root="HKCU" Key="Software\Classes\lnkfile\shell\RegKeeperUninstall" Value="Удалить с RegKeeper" Type="string"/>
                    <RegistryValue Root="HKCU" Key="Software\Classes\lnkfile\shell\RegKeeperUninstall" Name="Icon" Value="[INSTALLFOLDER]RegKeeper.exe" Type="string"/>
                    <RegistryValue Root="HKCU" Key="Software\Classes\lnkfile\shell\RegKeeperUninstall\command" Value="&quot;[INSTALLFOLDER]RegKeeper.exe&quot; --uninstall &quot;%1&quot;" Type="string"/>
                </Component>
            </Feature>
            <Feature Id="Watcher" Title="Наблюдатель за автозагрузкой" Description="RegKeeper.Watcher: значок в трее, предупреждает о новых программах в автозагрузке.">
                <Component Directory="INSTALLFOLDER">
                    <File Id="WatcherExe" Source="$(Pub)\RegKeeper.Watcher.exe" KeyPath="yes"/>
                </Component>
                <!-- off by default (level 2), the same switch as in Settings -->
                <Feature Id="WatcherRun" Level="2" Title="Запускать при входе в Windows" Description="Наблюдатель стартует вместе с Windows.">
                    <Component Directory="INSTALLFOLDER">
                        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="RegKeeper Watcher" Value="&quot;[INSTALLFOLDER]RegKeeper.Watcher.exe&quot;" Type="string" KeyPath="yes"/>
                    </Component>
                </Feature>
            </Feature>
        </Feature>

        <!-- wizard: welcome, licence, features with the folder picker, ready, progress, finish with "launch" -->
        <WixVariable Id="WixUILicenseRtf" Value="License.rtf"/>
        <WixVariable Id="WixUIBannerBmp" Value="banner.bmp"/>
        <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp"/>
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Запустить RegKeeper"/>
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
        <Property Id="WixShellExecTarget" Value="[#RegKeeperExe]"/>
        <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes"/>

        <!-- "Browse" opens the Explorer folder dialog (FolderPicker.cs), not the MSI one; the picker adds \RegKeeper itself,
             the script hands its answer to INSTALLFOLDER. A cancelled dialog leaves no file and changes nothing. -->
        <Binary Id="FolderPicker" SourceFile="$(Picker)"/>
        <CustomAction Id="PickFolder" BinaryRef="FolderPicker" ExeCommand="&quot;[TempFolder]RegKeeper-pick.txt&quot; &quot;[INSTALLFOLDER].&quot;" Return="ignore"/>
        <CustomAction Id="ApplyPick" Script="jscript" ScriptSourceFile="ApplyPick.js" Return="ignore"/>

        <!-- RkCustomizeDlg: its icons (build.ps1 draws them) and the start state of its ticks: what MSI is about to install
             (defaults, or the old version's choice on an upgrade), or in maintenance what is installed and stays -->
        <Binary Id="RkIcoStart" SourceFile="$(Icons)\start.ico"/>
        <Binary Id="RkIcoDesktop" SourceFile="$(Icons)\desktop.ico"/>
        <Binary Id="RkIcoShell" SourceFile="$(Icons)\shell.ico"/>
        <Binary Id="RkIcoWatcher" SourceFile="$(Icons)\watcher.ico"/>
        <Binary Id="RkIcoFolder" SourceFile="$(Icons)\folder.ico"/>
        <SetProperty Id="RK_StartMenu" Value="1" Sequence="ui" After="MigrateFeatureStates" Condition="&amp;StartMenu = 3 OR (&amp;StartMenu = -1 AND !StartMenu = 3)"/>
        <SetProperty Id="RK_Desktop" Value="1" Sequence="ui" After="MigrateFeatureStates" Condition="&amp;Desktop = 3 OR (&amp;Desktop = -1 AND !Desktop = 3)"/>
        <SetProperty Id="RK_ShellVerb" Value="1" Sequence="ui" After="MigrateFeatureStates" Condition="&amp;ShellVerb = 3 OR (&amp;ShellVerb = -1 AND !ShellVerb = 3)"/>
        <SetProperty Id="RK_Watcher" Value="1" Sequence="ui" After="MigrateFeatureStates" Condition="&amp;Watcher = 3 OR (&amp;Watcher = -1 AND !Watcher = 3)"/>
        <SetProperty Id="RK_WatcherRun" Value="1" Sequence="ui" After="MigrateFeatureStates" Condition="&amp;WatcherRun = 3 OR (&amp;WatcherRun = -1 AND !WatcherRun = 3)"/>

        <!-- WixUI_FeatureTree with its CustomizeDlg swapped for RkCustomizeDlg below, in Segoe UI instead of Tahoma -->
        <UI Id="RkUI">
            <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="8"/>
            <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12"/>
            <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes"/>
            <TextStyle Id="RkStrong" FaceName="Segoe UI Semibold" Size="8" Red="17" Green="17" Blue="19"/>
            <TextStyle Id="RkMuted" FaceName="Segoe UI" Size="8" Red="95" Green="95" Blue="103"/>
            <Property Id="DefaultUIFont" Value="WixUI_Font_Normal"/>
            <DialogRef Id="ErrorDlg"/>
            <DialogRef Id="FatalError"/>
            <DialogRef Id="FilesInUse"/>
            <DialogRef Id="MsiRMFilesInUse"/>
            <DialogRef Id="PrepareDlg"/>
            <DialogRef Id="ProgressDlg"/>
            <DialogRef Id="ResumeDlg"/>
            <DialogRef Id="UserExit"/>
            <DialogRef Id="WelcomeDlg"/>
            <DialogRef Id="LicenseAgreementDlg"/>
            <DialogRef Id="VerifyReadyDlg"/>
            <DialogRef Id="MaintenanceWelcomeDlg"/>
            <DialogRef Id="MaintenanceTypeDlg"/>
            <DialogRef Id="DiskCostDlg"/>

            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed"/>
            <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999"/>
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed"/>
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH"/>
            <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64"/>
            <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"/>
            <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="RkCustomizeDlg" Condition="LicenseAccepted = &quot;1&quot;"/>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="RkCustomizeDlg" Order="1" Condition="NOT Installed OR WixUI_InstallMode = &quot;Change&quot;"/>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH"/>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="Installed AND PATCH"/>
            <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg"/>
            <Publish Dialog="MaintenanceTypeDlg" Control="ChangeButton" Event="NewDialog" Value="RkCustomizeDlg"/>
            <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg"/>
            <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg"/>
            <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg"/>

            <!-- components as ticks with an icon each instead of the MSI feature tree (grey drive icons, nothing to restyle);
                 a tick is an RK_* property, seeded below from what MSI plans for the feature and turned into AddLocal/Remove on "Next" -->
            <Dialog Id="RkCustomizeDlg" Width="370" Height="270" Title="!(loc.CustomizeDlg_Title)" TrackDiskSpace="yes">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.CustomizeDlgBannerBitmap)"/>
                <Control Id="Title" Type="Text" X="15" Y="6" Width="210" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Компоненты"/>
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="RegKeeper ставится всегда. Отметьте, что добавить к нему."/>
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>

                <Control Id="StartIcon" Type="Icon" X="20" Y="54" Width="24" Height="24" IconSize="32" FixedSize="yes" Text="RkIcoStart"/>
                <Control Id="StartBox" Type="CheckBox" X="52" Y="54" Width="290" Height="12" Property="RK_StartMenu" CheckBoxValue="1" Text="{\RkStrong}Ярлык в меню Пуск"/>
                <Control Id="StartText" Type="Text" X="66" Y="66" Width="280" Height="10" NoPrefix="yes" Text="{\RkMuted}RegKeeper в списке программ меню Пуск."/>

                <Control Id="DesktopIcon" Type="Icon" X="20" Y="84" Width="24" Height="24" IconSize="32" FixedSize="yes" Text="RkIcoDesktop"/>
                <Control Id="DesktopBox" Type="CheckBox" X="52" Y="84" Width="290" Height="12" Property="RK_Desktop" CheckBoxValue="1" Text="{\RkStrong}Ярлык на рабочем столе"/>
                <Control Id="DesktopText" Type="Text" X="66" Y="96" Width="280" Height="10" NoPrefix="yes" Text="{\RkMuted}На общем рабочем столе, для всех пользователей."/>

                <Control Id="ShellIcon" Type="Icon" X="20" Y="114" Width="24" Height="24" IconSize="32" FixedSize="yes" Text="RkIcoShell"/>
                <Control Id="ShellBox" Type="CheckBox" X="52" Y="114" Width="290" Height="12" Property="RK_ShellVerb" CheckBoxValue="1" Text="{\RkStrong}Пункт «Удалить с RegKeeper»"/>
                <Control Id="ShellText" Type="Text" X="66" Y="126" Width="280" Height="20" NoPrefix="yes" Text="{\RkMuted}В меню exe-файлов и ярлыков по правой кнопке. В Windows 11 он в «Показать дополнительные параметры»."/>

                <Control Id="WatcherIcon" Type="Icon" X="20" Y="150" Width="24" Height="24" IconSize="32" FixedSize="yes" Text="RkIcoWatcher"/>
                <Control Id="WatcherBox" Type="CheckBox" X="52" Y="150" Width="290" Height="12" Property="RK_Watcher" CheckBoxValue="1" Text="{\RkStrong}Наблюдатель за автозагрузкой"/>
                <Control Id="WatcherText" Type="Text" X="66" Y="162" Width="280" Height="10" NoPrefix="yes" Text="{\RkMuted}Значок в трее, предупреждает о новых программах в автозагрузке."/>
                <Control Id="WatcherRunBox" Type="CheckBox" X="66" Y="175" Width="276" Height="12" Property="RK_WatcherRun" CheckBoxValue="1" Text="Запускать при входе в Windows" DisableCondition="NOT RK_Watcher" EnableCondition="RK_Watcher"/>

                <Control Id="FolderIcon" Type="Icon" X="20" Y="201" Width="24" Height="24" IconSize="32" FixedSize="yes" Text="RkIcoFolder" HideCondition="Installed"/>
                <Control Id="LocationLabel" Type="Text" X="52" Y="201" Width="200" Height="10" NoPrefix="yes" Text="{\RkMuted}Папка установки" HideCondition="Installed"/>
                <Control Id="Location" Type="Text" X="52" Y="212" Width="236" Height="12" NoPrefix="yes" Text="{\RkStrong}[INSTALLFOLDER]" HideCondition="Installed"/>
                <!-- "Browse" opens FolderPicker; the Property publish makes the location line above repaint -->
                <Control Id="Browse" Type="PushButton" X="294" Y="205" Width="66" Height="17" Text="Изменить..." HideCondition="Installed" DisableCondition="Installed">
                    <Publish Event="DoAction" Value="PickFolder" Order="1"/>
                    <Publish Event="DoAction" Value="ApplyPick" Order="2"/>
                    <Publish Property="INSTALLFOLDER" Value="[INSTALLFOLDER]" Order="3"/>
                </Control>

                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
                <Control Id="Back" Type="PushButton" X="192" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
                    <Publish Event="NewDialog" Value="MaintenanceTypeDlg" Order="1" Condition="Installed"/>
                    <Publish Event="NewDialog" Value="LicenseAgreementDlg" Order="2" Condition="NOT Installed"/>
                </Control>
                <Control Id="Next" Type="PushButton" X="248" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                    <!-- a removed parent takes WatcherRun with it; adding WatcherRun alone would pull Watcher back in -->
                    <Publish Event="AddLocal" Value="StartMenu" Order="1" Condition="RK_StartMenu"/>
                    <Publish Event="Remove" Value="StartMenu" Order="2" Condition="NOT RK_StartMenu"/>
                    <Publish Event="AddLocal" Value="Desktop" Order="3" Condition="RK_Desktop"/>
                    <Publish Event="Remove" Value="Desktop" Order="4" Condition="NOT RK_Desktop"/>
                    <Publish Event="AddLocal" Value="ShellVerb" Order="5" Condition="RK_ShellVerb"/>
                    <Publish Event="Remove" Value="ShellVerb" Order="6" Condition="NOT RK_ShellVerb"/>
                    <Publish Event="AddLocal" Value="Watcher" Order="7" Condition="RK_Watcher"/>
                    <Publish Event="AddLocal" Value="WatcherRun" Order="8" Condition="RK_Watcher AND RK_WatcherRun"/>
                    <Publish Event="Remove" Value="WatcherRun" Order="9" Condition="NOT RK_Watcher OR NOT RK_WatcherRun"/>
                    <Publish Event="Remove" Value="Watcher" Order="10" Condition="NOT RK_Watcher"/>
                    <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="11"/>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg"/>
                </Control>
            </Dialog>
        </UI>
        <UIRef Id="WixUI_Common"/>
    </Package>
</Wix>
