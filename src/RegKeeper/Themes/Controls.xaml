<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rk="clr-namespace:RegKeeper"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- control styles shared by both themes; colours come from the theme dictionary via DynamicResource -->
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- shape and spacing tokens: cards 22, buttons and fields 14, tiles 11; gaps between cards 18 -->
    <CornerRadius x:Key="RCard">22</CornerRadius>
    <CornerRadius x:Key="RCardIn">21</CornerRadius>
    <CornerRadius x:Key="RControl">14</CornerRadius>
    <CornerRadius x:Key="RControlIn">13</CornerRadius>
    <CornerRadius x:Key="RRing">17</CornerRadius>
    <CornerRadius x:Key="RTile">11</CornerRadius>
    <CornerRadius x:Key="RBar">3</CornerRadius>
    <Thickness x:Key="CardPad">22,20</Thickness>
    <Thickness x:Key="Gap">0,0,18,18</Thickness>
    <sys:Double x:Key="BarHeight">6</sys:Double>
    <!-- controls and table rows share one height so toolbars line up -->
    <sys:Double x:Key="ControlHeight">44</sys:Double>
    <sys:Double x:Key="SearchHeight">52</sys:Double>
    <sys:Double x:Key="RowHeight">52</sys:Double>
    <sys:Double x:Key="ColumnMin">150</sys:Double>
    <Thickness x:Key="TablePad">8,6,8,8</Thickness>
    <Thickness x:Key="Toolbar">0,24,0,14</Thickness>

    <!-- Motion tokens, the only place durations and easings live. Motion.cs reads the same keys; reduced motion zeroes the T* ones.
         Enter = cubic-bezier(0.16,1,0.3,1), Exit = (0.4,0,1,1) at ~70% of the enter time, Move = (0.65,0,0.35,1) between states. -->
    <KeyTime x:Key="TPress">0:0:0.08</KeyTime>
    <KeyTime x:Key="THover">0:0:0.12</KeyTime>
    <KeyTime x:Key="TFast">0:0:0.15</KeyTime>
    <KeyTime x:Key="TBase">0:0:0.25</KeyTime>
    <KeyTime x:Key="TSlow">0:0:0.3</KeyTime>
    <KeyTime x:Key="TCount">0:0:0.7</KeyTime>
    <KeyTime x:Key="TStagger">0:0:0.035</KeyTime>
    <KeyTime x:Key="TSpotIn">0:0:0.2</KeyTime>
    <KeyTime x:Key="TSpotOut">0:0:0.3</KeyTime>
    <KeySpline x:Key="EaseEnter">0.16,1 0.3,1</KeySpline>
    <KeySpline x:Key="EaseExit">0.4,0 1,1</KeySpline>
    <KeySpline x:Key="EaseMove">0.65,0 0.35,1</KeySpline>
    <!-- cursor light: radius in px, the pressed share of it, how far the light catches up with the cursor per frame, the halo blur -->
    <sys:Double x:Key="SpotRadius">120</sys:Double>
    <sys:Double x:Key="SpotNavRadius">90</sys:Double>
    <sys:Double x:Key="SpotPress">0.67</sys:Double>
    <sys:Double x:Key="SpotLerp">0.2</sys:Double>
    <BlurEffect x:Key="SpotBlur" Radius="30"/>

    <!-- shared storyboards: templates name their parts h (hover fill), ring (focus ring), b (pressable body), c (check path) -->
    <Storyboard x:Key="HoverIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="h" Storyboard.TargetProperty="Opacity">
            <SplineDoubleKeyFrame KeyTime="{StaticResource THover}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="HoverOut">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="h" Storyboard.TargetProperty="Opacity">
            <SplineDoubleKeyFrame KeyTime="{StaticResource TPress}" KeySpline="{StaticResource EaseExit}" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="LiftIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="lift" Storyboard.TargetProperty="RenderTransform.Y">
            <SplineDoubleKeyFrame KeyTime="{StaticResource TFast}" KeySpline="{StaticResource EaseEnter}" Value="-1"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="LiftOut">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="lift" Storyboard.TargetProperty="RenderTransform.Y">
            <SplineDoubleKeyFrame KeyTime="{StaticResource TFast}" KeySpline="{StaticResource EaseExit}" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="RingIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ring" Storyboard.TargetProperty="Opacity">
            <SplineDoubleKeyFrame KeyTime="{StaticResource THover}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="RingOut">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ring" Storyboard.TargetProperty="Opacity">
            <SplineDoubleKeyFrame KeyTime="{StaticResource TPress}" KeySpline="{StaticResource EaseExit}" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="PressIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.ScaleX">
            <SplineDoubleKeyFrame KeyTime="{StaticResource TPress}" KeySpline="{StaticResource EaseEnter}" Value="0.97"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.ScaleY">
            <SplineDoubleKeyFrame KeyTime="{StaticResource TPress}" KeySpline="{StaticResource EaseEnter}" Value="0.97"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="PressOut">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.ScaleX">
            <SplineDoubleKeyFrame KeyTime="{StaticResource THover}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.ScaleY">
            <SplineDoubleKeyFrame KeyTime="{StaticResource THover}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="CheckIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="h" Storyboard.TargetProperty="Opacity">
            <SplineDoubleKeyFrame KeyTime="{StaticResource THover}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="c" Storyboard.TargetProperty="StrokeDashOffset">
            <SplineDoubleKeyFrame KeyTime="{StaticResource TFast}" KeySpline="{StaticResource EaseEnter}" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="CheckOut">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="h" Storyboard.TargetProperty="Opacity">
            <SplineDoubleKeyFrame KeyTime="{StaticResource TPress}" KeySpline="{StaticResource EaseExit}" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="c" Storyboard.TargetProperty="StrokeDashOffset">
            <SplineDoubleKeyFrame KeyTime="{StaticResource TPress}" KeySpline="{StaticResource EaseExit}" Value="8"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- dialogs and the main window: the panel fades in and scales from 0.97 -->
    <!-- interface size from Settings; Theme.ApplyScale replaces it at the application level -->
    <ScaleTransform x:Key="UiScale" ScaleX="1" ScaleY="1"/>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}">
                        <AdornerDecorator x:Name="a" RenderTransformOrigin="0.5,0.5" LayoutTransform="{DynamicResource UiScale}">
                            <AdornerDecorator.RenderTransform><ScaleTransform/></AdornerDecorator.RenderTransform>
                            <ContentPresenter/>
                        </AdornerDecorator>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="a" Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0" Value="0"/>
                                        <SplineDoubleKeyFrame KeyTime="{StaticResource TBase}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="a" Storyboard.TargetProperty="RenderTransform.ScaleX">
                                        <DiscreteDoubleKeyFrame KeyTime="0" Value="0.97"/>
                                        <SplineDoubleKeyFrame KeyTime="{StaticResource TBase}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="a" Storyboard.TargetProperty="RenderTransform.ScaleY">
                                        <DiscreteDoubleKeyFrame KeyTime="0" Value="0.97"/>
                                        <SplineDoubleKeyFrame KeyTime="{StaticResource TBase}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- page header of every screen: 40 display title, 16 grey lead capped at 820 -->
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,22,0,10"/>
    </Style>
    <!-- hints and status lines; a status line that gains numbers after load counts them up -->
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="rk:Motion.CountUp" Value="True"/>
    </Style>
    <Style x:Key="DangerText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
    </Style>
    <Style x:Key="Lead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="820"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="Figure" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- cards: top-lit gradient with a gradient edge; the soft shadow comes from a copy behind, inset so it only shows below
         (CSS 0 24 48 -28). HotCard is the coral variant for "can be freed". -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
        <Setter Property="Padding" Value="{StaticResource CardPad}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="rk:Ui.Glow" Value="{DynamicResource CardShadow}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="16,24,16,0" CornerRadius="{StaticResource RCard}" Background="{DynamicResource BgBrush}"
                                Effect="{TemplateBinding rk:Ui.Glow}"/>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RCard}" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HotCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource HotCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HotEdgeBrush}"/>
        <Setter Property="rk:Ui.Glow" Value="{DynamicResource HotCardShadow}"/>
    </Style>
    <!-- app tile: icon on a dark gradient square, the first letter when the package has no logo -->
    <DataTemplate x:Key="AppTile">
        <Border Width="42" Height="42" CornerRadius="{StaticResource RTile}" BorderThickness="1"
                Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource TileEdgeBrush}">
            <Grid>
                <TextBlock x:Name="l" Text="{Binding Letter}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon}" Width="26" Height="26"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="l" Property="Visibility" Value="Visible"/></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- outlined pill badge for short labels (type, category, scope); empty text shows nothing -->
    <DataTemplate x:Key="Badge">
        <Border x:Name="p" CornerRadius="10.5" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="8,1,8,2" HorizontalAlignment="Left">
            <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value=""><Setter TargetName="p" Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter TargetName="p" Property="Visibility" Value="Collapsed"/></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <!-- status badge for problems: muted red dot and text -->
    <DataTemplate x:Key="DangerBadge">
        <Border x:Name="p" CornerRadius="10.5" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="7,1,8,2" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource DangerTextBrush}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value=""><Setter TargetName="p" Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter TargetName="p" Property="Visibility" Value="Collapsed"/></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 34px app icon tile with a 20px icon; a row without an icon shows its Glyph, or a generic app glyph -->
    <DataTemplate x:Key="AppIcon">
        <Border Width="34" Height="34" CornerRadius="{StaticResource RTile}" BorderThickness="1" HorizontalAlignment="Center"
                Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource TileEdgeBrush}">
            <Grid>
                <TextBlock x:Name="g" Text="{Binding Glyph, FallbackValue=&#xE71D;}" FontFamily="{StaticResource Icons}" FontSize="16"
                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon}" Width="20" Height="20"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="g" Property="Visibility" Value="Visible"/></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- buttons: ghost by default; Tag is the hover fill, faded in over the base. Ui.Glow is an optional shadow cast by a copy of the
         body behind it, so the label keeps ClearType -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="18,6"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Margin" Value="0,4,8,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Tag" Value="{DynamicResource HoverBrush}"/>
        <Setter Property="rk:Motion.Light" Value="{DynamicResource Spot}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="lift">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Border x:Name="ring" Margin="-3" CornerRadius="{StaticResource RRing}" BorderThickness="2" BorderBrush="{DynamicResource RingBrush}" Opacity="0"/>
                        <!-- cursor light (Motion.Spot): an optional blurred halo behind the body, a spotlight under the label, the lit border ring -->
                        <Border CornerRadius="{StaticResource RControl}" Effect="{DynamicResource SpotBlur}" SnapsToDevicePixels="False"
                                rk:Motion.SpotSize="{StaticResource SpotRadius}" rk:Motion.Spot="{TemplateBinding rk:Motion.Halo}"/>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RControl}"
                                Effect="{TemplateBinding rk:Ui.Glow}"/>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RControl}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <Grid>
                                <Border x:Name="h" Background="{TemplateBinding Tag}" CornerRadius="{StaticResource RControlIn}" Opacity="0"/>
                                <Border CornerRadius="{StaticResource RControlIn}"
                                        rk:Motion.SpotSize="{StaticResource SpotRadius}" rk:Motion.Spot="{TemplateBinding rk:Motion.Light}"/>
                                <Border Margin="-1" BorderThickness="1" CornerRadius="{StaticResource RControl}"
                                        rk:Motion.SpotSize="{StaticResource SpotRadius}" rk:Motion.Spot="{DynamicResource SpotEdge}"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/><BeginStoryboard Storyboard="{StaticResource LiftIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/><BeginStoryboard Storyboard="{StaticResource LiftOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource RingIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource RingOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="Tag" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="rk:Motion.Light" Value="{DynamicResource SpotAccent}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <!-- delete: the coral gradient, a light inset line along the top (the border) and a coral shadow below -->
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="Background" Value="{DynamicResource DangerFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerShineBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}"/>
        <Setter Property="Tag" Value="{DynamicResource DangerFillHoverBrush}"/>
        <Setter Property="rk:Motion.Light" Value="{DynamicResource SpotHot}"/>
        <Setter Property="rk:Motion.Halo" Value="{DynamicResource SpotHalo}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="rk:Ui.Glow" Value="{DynamicResource DangerShadow}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- an empty box shows its ToolTip as a placeholder: filter boxes have no label of their own -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ring" Margin="-3" CornerRadius="{StaticResource RRing}" BorderThickness="2" BorderBrush="{DynamicResource RingBrush}" Opacity="0"/>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RControl}" SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="Hint" Text="{Binding ToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource SubtleBrush}" Padding="{TemplateBinding Padding}" Margin="2,0,0,0"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource RingIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource RingOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- search: tall glass field with a magnifier (the TextBox template draws Tag as a leading glyph) -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="{StaticResource SearchHeight}"/>
        <Setter Property="Padding" Value="44,0,14,0"/>
        <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
        <Setter Property="Tag" Value="&#xE721;"/>
    </Style>

    <!-- checkbox: the mark draws itself (stroke-dashoffset, in stroke-thickness units: the path is ~7.5 long) -->
    <Style TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="ring" Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource RingBrush}" Opacity="0"/>
                            <Border x:Name="box" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Background="{DynamicResource SurfaceBrush}"/>
                            <Border x:Name="h" CornerRadius="4" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <Path x:Name="c" Data="M3.5,8.5 L6.5,11.5 L12.5,5" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="8 8" StrokeDashOffset="8"/>
                        </Grid>
                        <ContentPresenter x:Name="text" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource CheckIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource CheckOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource SubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource RingIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource RingOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="text" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- DataGridCheckBoxColumn sets its own element styles, which skip the implicit one; Motion puts these in -->
    <Style x:Key="GridCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="-4,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="GridCheckEdit" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="-4,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- radio buttons are segments of a pill control: SettingsView slides the active pill under the checked one -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent" Padding="14,5">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Segments" TargetType="Border">
        <Setter Property="CornerRadius" Value="17.5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="13.5"/>
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
        <Setter Property="Visibility" Value="Hidden"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" MaxWidth="420">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- context menus: a rounded surface that scales in from 96%; items carry their glyph in Tag. The popup lives
         outside the window, so it takes the interface scale itself. The shadow is a sibling so text keeps ClearType. -->
    <Storyboard x:Key="MenuIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
            <SplineDoubleKeyFrame KeyTime="{StaticResource TFast}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.ScaleX">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.96"/>
            <SplineDoubleKeyFrame KeyTime="{StaticResource TFast}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.ScaleY">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.96"/>
            <SplineDoubleKeyFrame KeyTime="{StaticResource TFast}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="LayoutTransform" Value="{DynamicResource UiScale}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid x:Name="b" Margin="0,0,10,10" RenderTransformOrigin="0,0">
                        <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.14"/></Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="4" MinWidth="210">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource MenuIn}"/></Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Background="Transparent">
                        <Border x:Name="h" Background="{DynamicResource HoverBrush}" CornerRadius="5" Opacity="0"/>
                        <DockPanel Margin="8,7,14,7">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="14" Width="16" Margin="0,0,10,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="{DynamicResource LineBrush}"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- thin scrollbars: a rounded thumb on a clear track -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="3" Margin="2" Background="{DynamicResource BorderStrongBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <!-- ListBox in a card; MainWindow's sidebar sets its own template -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
        <Setter Property="Padding" Value="{StaticResource TablePad}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Grid>
                        <Border Margin="16,24,16,0" CornerRadius="{StaticResource RCard}" Background="{DynamicResource BgBrush}" Effect="{DynamicResource CardShadow}"/>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RCard}">
                            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>
    <!-- stock ListBoxItem selection colours are fixed light blues -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RTile}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource RowSelBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SelEdgeBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
        <Setter Property="Padding" Value="{StaticResource TablePad}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Grid>
                        <Border Margin="16,24,16,0" CornerRadius="{StaticResource RCard}" Background="{DynamicResource BgBrush}" Effect="{DynamicResource CardShadow}"/>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RCard}">
                            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="False"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- stock ComboBox paints a fixed light gradient, so it gets a flat template; the list scales in from 0.96 -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="14,6,30,6"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="{StaticResource RControl}">
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,11,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False">
                            <Border x:Name="pb" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" RenderTransformOrigin="0.5,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <ScrollViewer><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="pb" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource TFast}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="pb" Storyboard.TargetProperty="RenderTransform.ScaleX">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="0.96"/>
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource TFast}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="pb" Storyboard.TargetProperty="RenderTransform.ScaleY">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="0.96"/>
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource TFast}" KeySpline="{StaticResource EaseEnter}" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="8,5">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a text column's cell (Motion.ThemeChecks): wraps rather than cuts when the window is narrow -->
    <Style x:Key="GridText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>
    <!-- tables are cards: faint row dividers, hover a lighter fill, the selected row gets an edge; rows stagger in on first load -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/>
        <!-- rows are at least RowHeight and grow when wrapped text needs more (GridText) -->
        <Setter Property="RowHeight" Value="NaN"/>
        <Setter Property="MinRowHeight" Value="{StaticResource RowHeight}"/>
        <!-- star columns keep ColumnMin (Motion.ThemeChecks); a window too narrow for that scrolls sideways instead of crushing text -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource TablePad}"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="rk:Motion.Stagger" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Grid>
                    <Border Margin="16,24,16,0" CornerRadius="{StaticResource RCard}" Background="{DynamicResource BgBrush}" Effect="{DynamicResource CardShadow}"/>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RCard}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.ColumnSpan="2"/>
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                        <!-- grouped grids: the title of the group at the top stays pinned here (Motion.Stick) -->
                                        <Border Grid.Row="1" ClipToBounds="True" IsHitTestVisible="False">
                                            <Border x:Name="Sticky" VerticalAlignment="Top" Visibility="Collapsed" Background="{DynamicResource CardTopBrush}"
                                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                        </Border>
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1" Orientation="Vertical"
                                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Orientation="Horizontal"
                                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowSelBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SelEdgeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontSize" Value="13"/>
        <!-- a header wraps rather than cut off when its column is at its narrowest -->
        <Setter Property="ContentTemplate">
            <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
