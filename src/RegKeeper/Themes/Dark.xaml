<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme: zinc monochrome. Views use the *Brush keys via DynamicResource; contrast is checked by scripts/gates/check.mjs contrast.
         Borders are opaque equivalents of white at 8% / 16% over the page, so they read the same on every surface. -->
    <Color x:Key="Bg">#09090B</Color>
    <Color x:Key="Surface">#121214</Color>
    <Color x:Key="Pane">#0F0F11</Color>
    <Color x:Key="Alt">#161619</Color>
    <Color x:Key="Hover">#1C1C1F</Color>
    <Color x:Key="Selection">#27272A</Color>
    <Color x:Key="Text">#FAFAFA</Color>
    <Color x:Key="Muted">#A1A1AA</Color>
    <Color x:Key="Subtle">#71717A</Color>
    <Color x:Key="Border">#27272A</Color>
    <Color x:Key="BorderStrong">#3F3F46</Color>
    <Color x:Key="Line">#1C1C1F</Color>
    <Color x:Key="Ring">#40FFFFFF</Color>
    <Color x:Key="Accent">#FAFAFA</Color>
    <Color x:Key="AccentHover">#D4D4D8</Color>
    <Color x:Key="OnAccent">#09090B</Color>
    <Color x:Key="Danger">#F07272</Color>
    <Color x:Key="DangerHover">#F49A9A</Color>
    <Color x:Key="DangerText">#F07272</Color>
    <Color x:Key="Success">#22C55E</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="PaneBrush" Color="{StaticResource Pane}"/>
    <SolidColorBrush x:Key="AltBrush" Color="{StaticResource Alt}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource Hover}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource Selection}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource Subtle}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/>
    <SolidColorBrush x:Key="RingBrush" Color="{StaticResource Ring}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccent}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHover}"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerText}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>

    <!-- stock control templates (TreeView, menus, tooltips) read these -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Pane}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Selection}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Selection}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="{StaticResource Text}"/>
</ResourceDictionary>
