<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme, the design system's source palette: flat surfaces, 1px lines, one red for irreversible actions.
         Views use the *Brush keys via DynamicResource; contrast is checked by scripts/gates/check.mjs contrast,
         which lays translucent colours over Bg. Light.xaml has the same keys. -->

    <!-- design tokens -->
    <Color x:Key="Bg">#0F0F11</Color>
    <Color x:Key="Side">#0B0B0D</Color>
    <Color x:Key="Surface">#17171A</Color>
    <Color x:Key="Surface2">#222226</Color>
    <Color x:Key="PanelLine">#2A2A2F</Color>
    <Color x:Key="LineSoft">#1F1F23</Color>
    <Color x:Key="Text">#EDEDEF</Color>
    <Color x:Key="Muted">#8E8E96</Color>
    <Color x:Key="Faint">#5D5D65</Color>
    <Color x:Key="Primary">#F2F2F4</Color>
    <Color x:Key="OnPrimary">#111113</Color>
    <Color x:Key="Reversible">#CFCFD4</Color>
    <Color x:Key="Danger">#EF5B62</Color>
    <Color x:Key="DangerTint">#21EF5B62</Color>
    <Color x:Key="TagFill">#12FFFFFF</Color>
    <Color x:Key="TagStrong">#17FFFFFF</Color>
    <Color x:Key="Bar">#1D1D21</Color>
    <Color x:Key="BarEdge">#36363C</Color>
    <Color x:Key="GlowRed">#1A78141A</Color>
    <Color x:Key="GlowRedClear">#0078141A</Color>

    <!-- older names the screens and gates use, set from the tokens above -->
    <Color x:Key="Pane">#131316</Color>
    <Color x:Key="Alt">#1B1B1F</Color>
    <Color x:Key="Hover">#0AFFFFFF</Color>
    <Color x:Key="RowHover">#08FFFFFF</Color>
    <Color x:Key="Selection">#222226</Color>
    <Color x:Key="Subtle">#85858D</Color>
    <Color x:Key="Border">#2A2A2F</Color>
    <Color x:Key="BorderStrong">#36363C</Color>
    <Color x:Key="Line">#1F1F23</Color>
    <Color x:Key="Ring">#66F2F2F4</Color>
    <Color x:Key="Accent">#F2F2F4</Color>
    <Color x:Key="AccentHover">#FFFFFF</Color>
    <Color x:Key="OnAccent">#111113</Color>
    <Color x:Key="DangerHover">#F3737A</Color>
    <Color x:Key="DangerEnd">#EF5B62</Color>
    <Color x:Key="DangerDeep">#EF5B62</Color>
    <Color x:Key="OnDanger">#111113</Color>
    <Color x:Key="DangerText">#F2767C</Color>
    <Color x:Key="DangerSoft">#21EF5B62</Color>
    <Color x:Key="DangerEdge">#59EF5B62</Color>
    <Color x:Key="Success">#CFCFD4</Color>
    <Color x:Key="Glass">#17171A</Color>
    <Color x:Key="Dim">#5D5D65</Color>
    <Color x:Key="Track">#222226</Color>
    <Color x:Key="Tile1">#222226</Color>
    <Color x:Key="Tile2">#222226</Color>
    <Color x:Key="TileEdge">#2A2A2F</Color>
    <Color x:Key="CardTop">#17171A</Color>
    <Color x:Key="CardBottom">#17171A</Color>
    <Color x:Key="HotTop">#17171A</Color>
    <Color x:Key="HotBottom">#17171A</Color>
    <Color x:Key="NavTop">#222226</Color>
    <Color x:Key="NavEdge">#222226</Color>
    <Color x:Key="SelTop">#222226</Color>
    <Color x:Key="SelEdge">#2A2A2F</Color>
    <Color x:Key="SegFirst">#F2F2F4</Color>
    <Color x:Key="SegFirstEnd">#F2F2F4</Color>
    <Color x:Key="Seg3">#8E8E96</Color>
    <Color x:Key="Seg4">#5D5D65</Color>
    <Color x:Key="Seg5">#44444C</Color>
    <Color x:Key="SegOther">#2A2A2F</Color>
    <Color x:Key="GlowLightColor">#FFFFFF</Color>
    <Color x:Key="Shadow">#000000</Color>
    <Color x:Key="Shine">#00FFFFFF</Color>
    <Color x:Key="ShineClear">#00FFFFFF</Color>
    <!-- cursor light (Motion.Spot): kept faint, the system has no glow -->
    <Color x:Key="Spot">#0DFFFFFF</Color>
    <Color x:Key="SpotEdge">#26FFFFFF</Color>
    <Color x:Key="SpotAccent">#40FFFFFF</Color>
    <Color x:Key="SpotHot">#26FFFFFF</Color>
    <Color x:Key="SpotHalo">#00EF5B62</Color>
    <Color x:Key="SpotNav">#0AFFFFFF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}"/>
    <SolidColorBrush x:Key="SideBrush" Color="{StaticResource Side}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}"/>
    <SolidColorBrush x:Key="PanelLineBrush" Color="{StaticResource PanelLine}"/>
    <SolidColorBrush x:Key="LineSoftBrush" Color="{StaticResource LineSoft}"/>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource Faint}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimary}"/>
    <SolidColorBrush x:Key="ReversibleBrush" Color="{StaticResource Reversible}"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTint}"/>
    <SolidColorBrush x:Key="TagBrush" Color="{StaticResource TagFill}"/>
    <SolidColorBrush x:Key="TagStrongBrush" Color="{StaticResource TagStrong}"/>
    <SolidColorBrush x:Key="BarBrush" Color="{StaticResource Bar}"/>
    <SolidColorBrush x:Key="BarEdgeBrush" Color="{StaticResource BarEdge}"/>
    <SolidColorBrush x:Key="PaneBrush" Color="{StaticResource Pane}"/>
    <SolidColorBrush x:Key="AltBrush" Color="{StaticResource Alt}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource Hover}"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHover}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource Selection}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource Subtle}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/>
    <SolidColorBrush x:Key="RingBrush" Color="{StaticResource Ring}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccent}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHover}"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerText}"/>
    <SolidColorBrush x:Key="OnDangerBrush" Color="{StaticResource OnDanger}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}"/>
    <SolidColorBrush x:Key="DangerEdgeBrush" Color="{StaticResource DangerEdge}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource Glass}"/>
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource Dim}"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource Track}"/>
    <SolidColorBrush x:Key="TileEdgeBrush" Color="{StaticResource TileEdge}"/>
    <SolidColorBrush x:Key="NavEdgeBrush" Color="{StaticResource NavEdge}"/>
    <SolidColorBrush x:Key="SelEdgeBrush" Color="{StaticResource SelEdge}"/>
    <SolidColorBrush x:Key="Seg3Brush" Color="{StaticResource Seg3}"/>
    <SolidColorBrush x:Key="Seg4Brush" Color="{StaticResource Seg4}"/>
    <SolidColorBrush x:Key="Seg5Brush" Color="{StaticResource Seg5}"/>
    <SolidColorBrush x:Key="SegOtherBrush" Color="{StaticResource SegOther}"/>
    <SolidColorBrush x:Key="CardTopBrush" Color="{StaticResource CardTop}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="CardEdgeBrush" Color="{StaticResource PanelLine}"/>
    <SolidColorBrush x:Key="HotCardBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="HotEdgeBrush" Color="{StaticResource DangerEdge}"/>
    <SolidColorBrush x:Key="TileBrush" Color="{StaticResource Surface2}"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="{StaticResource Surface2}"/>
    <SolidColorBrush x:Key="RowSelBrush" Color="{StaticResource Surface2}"/>
    <SolidColorBrush x:Key="DangerFillBrush" Color="{StaticResource DangerTint}"/>
    <SolidColorBrush x:Key="DangerFillHoverBrush" Color="{StaticResource DangerEdge}"/>
    <SolidColorBrush x:Key="DangerShineBrush" Color="{StaticResource DangerEdge}"/>
    <SolidColorBrush x:Key="HotBarBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="SegFirstBrush" Color="{StaticResource SegFirst}"/>
    <!-- the one background glow: dark red from the bottom left -->
    <SolidColorBrush x:Key="BgGlowBrush" Color="Transparent"/>
    <RadialGradientBrush x:Key="BgHotBrush" Center="0,1" GradientOrigin="0,1" RadiusX="0.6" RadiusY="0.7">
        <GradientStop Color="{StaticResource GlowRed}" Offset="0"/><GradientStop Color="{StaticResource GlowRedClear}" Offset="1"/>
    </RadialGradientBrush>

    <!-- panels cast no shadow; only the floating selection bar and popups do (0 18 40 .45) -->
    <DropShadowEffect x:Key="BarShadow" Color="{StaticResource Shadow}" Direction="270" ShadowDepth="18" BlurRadius="40" Opacity="0.45"/>
    <DropShadowEffect x:Key="GlowLight" Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="0" Opacity="0"/>
    <DropShadowEffect x:Key="GlowHot" Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="0" Opacity="0"/>
    <DropShadowEffect x:Key="CardShadow" Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="0" Opacity="0"/>
    <DropShadowEffect x:Key="HotCardShadow" Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="0" Opacity="0"/>
    <DropShadowEffect x:Key="DangerShadow" Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="0" Opacity="0"/>

    <!-- stock control templates (TreeView, menus, tooltips) read these -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Pane}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Selection}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Selection}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="{StaticResource Text}"/>
</ResourceDictionary>
