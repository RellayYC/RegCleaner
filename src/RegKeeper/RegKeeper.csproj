<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- only for the tray icon (NotifyIcon); its global usings would clash with WPF names -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\RegKeeper.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TaskScheduler" Version="2.11.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <InternalsVisibleTo Include="RegKeeper.Tests" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- update channel, passed by installer\build.ps1; a build without it has no online updates -->
  <ItemGroup Condition="'$(UpdateUrl)' != ''">
    <AssemblyMetadata Include="UpdateUrl" Value="$(UpdateUrl)" />
    <AssemblyMetadata Include="UpdatePub" Value="$(UpdatePub)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\**" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\RegKeeper.ico" />
  </ItemGroup>

</Project>
