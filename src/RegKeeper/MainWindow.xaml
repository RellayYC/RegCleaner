<Window x:Class="RegKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rk="clr-namespace:RegKeeper"
        Title="RegKeeper" Height="900" Width="1400" MinHeight="560" MinWidth="980"
        Icon="Assets/RegKeeper.ico" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- two soft glows over the flat window colour: white from the top right, coral from the bottom left -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource BgGlowBrush}" IsHitTestVisible="False"/>
        <Border Grid.ColumnSpan="2" Background="{DynamicResource BgHotBrush}" IsHitTestVisible="False"/>

        <Border Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,0">
                <!-- the mark: a glowing tile with the R knocked out of it; icon.ps1 draws the same shape into the .ico -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,26,0,22">
                    <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource AccentBrush}" Effect="{DynamicResource GlowLight}">
                        <Viewbox Width="30" Height="30">
                            <Canvas Width="32" Height="32">
                                <Path Data="M11,8 V24 M11,8 H16.5 A4.5,4.5 0 0 1 16.5,17 H11 M16,17 L22,24" Stroke="{DynamicResource OnAccentBrush}"
                                      StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Margin="13,0,0,1" VerticalAlignment="Center">
                        <Run Text="Reg"/><Run Text="Keeper" Foreground="{DynamicResource MutedBrush}"/>
                    </TextBlock>
                </StackPanel>

                <!-- the registry backup card: a restore point before any cleaning -->
                <Border x:Name="BackupCard" DockPanel.Dock="Bottom" Margin="0,12,0,20" CornerRadius="18" Padding="16,14"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" Effect="{DynamicResource GlowHot}" Margin="0,1,10,0" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10" Padding="0" Margin="6,-4,-6,-4"
                                    MinHeight="24" Width="24" BorderBrush="Transparent" Foreground="{DynamicResource MutedBrush}"
                                    ToolTip="Скрыть (вернуть можно в настройках)" AutomationProperties.Name="Скрыть" Click="HideBackup_Click"/>
                            <TextBlock Text="Резервная копия реестра" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="Точка восстановления Windows перед чисткой" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                                   Margin="18,4,0,12" TextWrapping="Wrap"/>
                        <Button Content="Создать копию" Margin="0" Padding="12,9" HorizontalAlignment="Stretch" Click="Backup_Click"/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="Nav_SelectionChanged" FontSize="15"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <!-- one pill under the items, slid onto the selected one by Motion.Slide -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Canvas>
                                        <Border x:Name="Pill" CornerRadius="16" Background="{DynamicResource NavActiveBrush}"
                                                BorderBrush="{DynamicResource NavEdgeBrush}" BorderThickness="1" Visibility="Hidden"/>
                                    </Canvas>
                                    <ItemsPresenter/>
                                </Grid>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtleBrush}" Margin="12,14,0,6"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" CornerRadius="16" Padding="8,9" Background="Transparent">
                                            <Grid>
                                                <Border x:Name="h" CornerRadius="16" Margin="-8,-9" Background="{DynamicResource HoverBrush}" Opacity="0"/>
                                                <!-- cursor light, softer than on buttons; over the active pill too -->
                                                <Border CornerRadius="16" Margin="-8,-9" rk:Motion.SpotSize="{StaticResource SpotNavRadius}" rk:Motion.Spot="{DynamicResource SpotNav}"/>
                                                <ContentPresenter/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="h" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <!-- the active item's tile turns inverted and glows -->
                                <Border x:Name="tile" Width="36" Height="36" CornerRadius="{StaticResource RTile}" BorderThickness="1"
                                        Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource TileEdgeBrush}">
                                    <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="16" FontWeight="Normal"
                                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="badge" DockPanel.Dock="Right" CornerRadius="9" Padding="7,1,7,2" VerticalAlignment="Center" Margin="6,0,0,0"
                                        Background="{DynamicResource HoverBrush}" Visibility="Collapsed">
                                    <TextBlock x:Name="badgeText" Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="tile" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="tile" Property="Effect" Value="{DynamicResource GlowLight}"/>
                                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasBadge}" Value="True"><Setter TargetName="badge" Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="light">
                                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="hot">
                                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 2px progress line while a module works (MainWindow.SetBusy) -->
        <Border x:Name="BusyBar" Grid.Column="1" Height="2" VerticalAlignment="Top" ClipToBounds="True" Visibility="Hidden">
            <Rectangle x:Name="BusyRun" Width="160" HorizontalAlignment="Left" Fill="{DynamicResource TextBrush}" Opacity="0.6">
                <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
            </Rectangle>
        </Border>
        <ContentControl x:Name="Host" Grid.Column="1" Margin="36,30,36,24" Focusable="False"/>
        <!-- the outgoing page as a picture while it fades (Motion.SwapPage) -->
        <Image x:Name="Ghost" Grid.Column="1" Margin="36,30,36,24" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
               IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</Window>
