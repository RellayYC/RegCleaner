<Window x:Class="RegKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rk="clr-namespace:RegKeeper"
        Title="RegKeeper" Height="900" Width="1400" MinHeight="560" MinWidth="980"
        Icon="Assets/RegKeeper.ico" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen">
    <!-- own 46px title bar; the glass line keeps the system shadow and the resize border -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource TitleBarHeight}" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleRow}"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- title bar: the window title, the command bar, the window buttons -->
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                   Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <!-- Ctrl+K: one box for programs, registry keys and tweaks; it hands the text to the module's own search -->
        <Grid Width="460" Height="32" HorizontalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBox x:Name="Omni" Style="{StaticResource SearchBox}" Height="32" MinHeight="32" FontSize="13" Padding="34,0,64,0"
                     ToolTip="Программа, ключ реестра или твик" TextChanged="Omni_TextChanged" PreviewKeyDown="Omni_KeyDown"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" Padding="7,2" CornerRadius="6"
                    Background="{DynamicResource Surface2Brush}" IsHitTestVisible="False">
                <TextBlock Text="Ctrl K" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"/>
            </Border>
            <Popup x:Name="OmniPop" PlacementTarget="{Binding ElementName=Omni}" Placement="Bottom" VerticalOffset="6" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="460" Margin="0,0,0,24" Padding="6" CornerRadius="{StaticResource RControl}" Background="{DynamicResource BarBrush}"
                        BorderBrush="{DynamicResource BarEdgeBrush}" BorderThickness="1">
                    <ListBox x:Name="OmniList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                             PreviewMouseLeftButtonUp="OmniList_Click" PreviewKeyDown="OmniList_KeyDown"/>
                </Border>
            </Popup>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource WinBtn}" Content="&#xE921;" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" Click="Minimize_Click"/>
            <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Content="&#xE922;" ToolTip="Развернуть" AutomationProperties.Name="Развернуть" Click="Maximize_Click"/>
            <Button Style="{StaticResource WinClose}" Content="&#xE8BB;" ToolTip="Закрыть" AutomationProperties.Name="Закрыть" Click="Close_Click"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="14,0,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SideColumn}"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- the sidebar island: brand, sections, the guard card, then Undo Center and Settings -->
        <Border Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="20" Padding="12,18,12,12">
        <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="6,0,0,10">
            <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                <TextBlock Text="R" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RegKeeper" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Всё можно отменить" FontSize="12" Foreground="{DynamicResource FaintBrush}"/>
            </StackPanel>
        </DockPanel>
        <!-- the sidebar scrolls only when the window is too short for it; otherwise the last group sits at the bottom -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="Nav_SelectionChanged" FontSize="14">
                    <!-- one active fill under the items, slid onto the selected one by Motion.Slide -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Grid>
                                <Canvas>
                                    <Border x:Name="Pill" CornerRadius="{StaticResource RControlIn}" Background="{DynamicResource NavActiveBrush}" Visibility="Hidden"/>
                                </Canvas>
                                <ItemsPresenter/>
                            </Grid>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <!-- the panel the groups themselves sit in: the last one docks to the bottom -->
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate><DockPanel LastChildFill="False"/></ItemsPanelTemplate>
                            </GroupStyle.Panel>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="DockPanel.Dock" Value="Top"/>
                                    <Style.Triggers>
                                        <!-- the unnamed group (Undo Center, Settings) goes under the protection card -->
                                        <DataTrigger Binding="{Binding Name}" Value=""><Setter Property="DockPanel.Dock" Value="Bottom"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock x:Name="t" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource FaintBrush}" Margin="12,14,0,6"/>
                                        <!-- room for the card, which is laid over this spot -->
                                        <Rectangle x:Name="room" Height="{Binding ActualHeight, ElementName=BackupCard}" Margin="0,0,0,10" Visibility="Collapsed"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="">
                                            <Setter TargetName="t" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="room" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Height="{StaticResource NavHeight}" Background="Transparent">
                                            <Border x:Name="h" CornerRadius="{StaticResource RControlIn}" Background="{DynamicResource HoverBrush}" Opacity="0"/>
                                            <Border CornerRadius="{StaticResource RControlIn}" rk:Motion.SpotSize="{StaticResource SpotNavRadius}" rk:Motion.Spot="{DynamicResource SpotNav}"/>
                                            <ContentPresenter Margin="12,0,8,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NavActiveTextBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="h" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="{StaticResource IconSize}" FontWeight="Normal"
                                           Width="{StaticResource IconSize}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="badge" DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="12.5" Margin="6,0,2,0" VerticalAlignment="Center"
                                           Opacity="0.6" Visibility="Collapsed"/>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,1" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasBadge}" Value="True"><Setter TargetName="badge" Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="light"><Setter TargetName="badge" Property="Opacity" Value="0.85"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- guard card: over the room the last group's header keeps, right above Undo Center and Settings -->
                <Border x:Name="BackupCard" VerticalAlignment="Bottom" Margin="0,0,0,82" CornerRadius="14" Padding="14"
                        Background="{DynamicResource Surface2Brush}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Создать точку восстановления" Click="Backup_Click"/>
                            <MenuItem Header="Скрыть (вернуть можно в настройках)" Click="HideBackup_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE710;" FontSize="12" MinHeight="24" Width="24" Margin="0,-4,-6,-4"
                                    ToolTip="Создать точку восстановления" AutomationProperties.Name="Создать точку восстановления" Click="Backup_Click"/>
                            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GuardTitle" Text="Можно отменить" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <UniformGrid x:Name="GuardBars" Rows="1" Columns="8" Margin="0,12,-4,10"/>
                        <TextBlock x:Name="GuardPoint" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        </DockPanel>
        </Border>

        <!-- 2px progress line while a module works (MainWindow.SetBusy) -->
        <Border x:Name="BusyBar" Grid.Column="2" Height="2" VerticalAlignment="Top" ClipToBounds="True" Visibility="Hidden">
            <Rectangle x:Name="BusyRun" Width="160" HorizontalAlignment="Left" Fill="{DynamicResource TextBrush}" Opacity="0.6">
                <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
            </Rectangle>
        </Border>
        <ContentControl x:Name="Host" Grid.Column="2" Margin="{StaticResource PagePad}" Focusable="False"/>
        <!-- the outgoing page as a picture while it fades (Motion.SwapPage) -->
        <Image x:Name="Ghost" Grid.Column="2" Margin="{StaticResource PagePad}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
               IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- stops whatever cancellable job runs (Ui.Busy with a token), same as Esc -->
        <Border x:Name="CancelPill" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
            <Border CornerRadius="{StaticResource RControl}" Background="{DynamicResource BarBrush}" Effect="{DynamicResource BarShadow}"/>
            <Button x:Name="CancelBtn" Style="{StaticResource Ghost}" Margin="0" Padding="12,0,8,0" BorderBrush="{DynamicResource BarEdgeBrush}"
                    Background="{DynamicResource BarBrush}" Foreground="{DynamicResource TextBrush}" Focusable="False"
                    AutomationProperties.Name="Отмена" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="6" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                        <TextBlock Text="Esc" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"/>
                    </Border>
                </StackPanel>
            </Button>
            </Grid>
        </Border>

        <!-- a new version found by the background check (MainWindow.CheckUpdate); the cross hides it until the next check -->
        <Border x:Name="UpdateToast" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,20,0" Width="300"
                Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <Grid>
            <Border CornerRadius="{StaticResource RCard}" Background="{DynamicResource BarBrush}" Effect="{DynamicResource BarShadow}"/>
            <Border CornerRadius="{StaticResource RCard}" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource BarEdgeBrush}" BorderThickness="1">
                <DockPanel>
                    <Button x:Name="UpdateClose" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="10"
                            MinHeight="24" Width="24" Margin="0,10,10,0" ToolTip="Не обновлять" AutomationProperties.Name="Не обновлять" Click="UpdateClose_Click"/>
                    <Button x:Name="UpdateGo" Style="{StaticResource Ghost}" Margin="0" Padding="14,12,4,12" Foreground="{DynamicResource TextBrush}"
                            HorizontalContentAlignment="Stretch" Click="UpdateGo_Click">
                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="{StaticResource IconSize}" Margin="0,1,12,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UpdateHint" Text="Нажмите, чтобы обновить" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DockPanel>
            </Border>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
