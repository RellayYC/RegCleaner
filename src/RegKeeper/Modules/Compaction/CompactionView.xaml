<UserControl x:Class="RegKeeper.Modules.CompactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- header: title and description, the counters on the right -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Разделов" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CountText" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Всего" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="SizeText" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Можно освободить" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="GainText" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Сжатие реестра" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Файлы реестра со временем фрагментируются. Анализ записывает сжатые копии разделов и показывает выигрыш. Перед сжатием можно создать точку восстановления, замена происходит при следующей перезагрузке. Старые файлы остаются резервной копией в папке сжатия."/>
                <TextBlock x:Name="Status" Style="{StaticResource DangerText}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" Text="Нужны права администратора: перезапустите RegKeeper от имени администратора."/>
            </StackPanel>
        </DockPanel>
        <!-- stepper: analyse, compact, reboot -->
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="{StaticResource Toolbar}">
                <ContentControl Style="{StaticResource Card}" Margin="0,0,10,0">
                    <DockPanel>
                        <Border x:Name="Step1" Style="{StaticResource StepDot}" Tag="on"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel>
                            <TextBlock Text="Анализ" FontWeight="SemiBold"/>
                            <TextBlock Text="Сжатые копии пишутся во временную папку, система не меняется." Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                            <Button x:Name="AnalyzeBtn" Content="Анализ" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0" Click="Analyze_Click"/>
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}" Margin="0,0,10,0">
                    <DockPanel>
                        <Border x:Name="Step2" Style="{StaticResource StepDot}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel>
                            <TextBlock Text="Сжатие" FontWeight="SemiBold"/>
                            <TextBlock Text="Файлы реестра ставятся на замену." Style="{StaticResource Hint}" Margin="0,2,0,8"/>
                            <CheckBox x:Name="RestorePoint" Style="{StaticResource Switch}" IsChecked="True" Margin="0,0,0,10" ToolTip="Без точки прежние файлы реестра останутся только в папке сжатия (*.old)"><TextBlock Text="Точка восстановления перед заменой" TextWrapping="Wrap"/></CheckBox>
                            <Button x:Name="CompactBtn" Content="Сжать" Style="{StaticResource DangerBtn}" HorizontalAlignment="Left" Margin="0" Click="Compact_Click" IsEnabled="False"/>
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <Border x:Name="Step3" Style="{StaticResource StepDot}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel>
                            <TextBlock Text="Перезагрузка" FontWeight="SemiBold"/>
                            <TextBlock Text="Замена происходит при следующем запуске Windows." Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                            <Button Content="Папка сжатия" HorizontalAlignment="Left" Margin="0" Click="Folder_Click"/>
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
        </UniformGrid>
        <DataGrid x:Name="Grid" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Раздел" Binding="{Binding Key}" Width="2*"/>
                <DataGridTextColumn Header="Файл" Binding="{Binding File}" Width="2*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" SortMemberPath="Size" Width="140"/>
                <DataGridTextColumn Header="После сжатия" Binding="{Binding CompactedText}" SortMemberPath="CompactedSize" Width="130"/>
                <DataGridTextColumn Header="Выигрыш" Binding="{Binding GainText}" SortMemberPath="Gain" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
