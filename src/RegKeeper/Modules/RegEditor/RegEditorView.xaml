<UserControl x:Class="RegKeeper.Modules.RegEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Редактор реестра" Style="{StaticResource Title}"/>
            <DockPanel Margin="0,10,0,8">
                <Button DockPanel.Dock="Right" Content="Из буфера" Click="Clipboard_Click" ToolTip="Перейти к пути из буфера обмена"/>
                <ComboBox x:Name="Favorites" DockPanel.Dock="Right" Width="220" Margin="6,0" SelectionChanged="Favorites_SelectionChanged" ToolTip="Избранное"/>
                <Button DockPanel.Dock="Right" Content="★" Click="AddFavorite_Click" ToolTip="Добавить текущий ключ в избранное (повторно - убрать)"/>
                <Button DockPanel.Dock="Right" Content="Перейти" Click="Go_Click"/>
                <TextBox x:Name="Address" KeyDown="Address_KeyDown" VerticalContentAlignment="Center"/>
            </DockPanel>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Раздел:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Content="Создать" Click="NewKey_Click"/>
                <Button Content="Переименовать" Click="RenameKey_Click"/>
                <Button Content="Копировать" Click="CopyKey_Click" ToolTip="Копия раздела со всем содержимым в другое место"/>
                <Button Content="Удалить" Style="{StaticResource DangerBtn}" Click="DeleteKey_Click"/>
                <Button Content="Экспорт .reg" Click="Export_Click"/>
                <Button Content="Импорт .reg" Click="Import_Click"/>
                <Button Content="Копировать путь" Click="CopyPath_Click"/>
                <Button Content="Обновить" Click="Refresh_Click"/>
            </WrapPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged"/>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <DockPanel Grid.Column="2">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Значение:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0"/>
                    <ComboBox x:Name="NewType" Width="150" SelectedIndex="0">
                        <ComboBoxItem Content="REG_SZ" Tag="1"/>
                        <ComboBoxItem Content="REG_EXPAND_SZ" Tag="2"/>
                        <ComboBoxItem Content="REG_MULTI_SZ" Tag="7"/>
                        <ComboBoxItem Content="REG_DWORD" Tag="4"/>
                        <ComboBoxItem Content="REG_QWORD" Tag="11"/>
                        <ComboBoxItem Content="REG_BINARY" Tag="3"/>
                    </ComboBox>
                    <Button Content="Создать" Click="NewValue_Click"/>
                    <Button Content="Изменить" Style="{StaticResource Primary}" Click="EditValue_Click"/>
                    <Button Content="Переименовать" Click="RenameValue_Click"/>
                    <Button Content="Удалить" Style="{StaticResource DangerBtn}" Click="DeleteValue_Click"/>
                </WrapPanel>
                <DataGrid x:Name="Values" IsReadOnly="True" SelectionMode="Extended" MouseDoubleClick="EditValue_Click">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="130"/>
                        <DataGridTextColumn Header="Значение" Binding="{Binding Data}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
