<UserControl x:Class="RegKeeper.Modules.RegCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rk="clr-namespace:RegKeeper"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:m="clr-namespace:RegKeeper.Modules">
    <DockPanel>
        <!-- header: title and description; scanning and fixing on the right -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Сканировать" Click="Scan_Click"/>
                <Button x:Name="FixBtn" Content="Исправить" Style="{StaticResource Primary}" Margin="0" Click="Fix_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Чистка реестра" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Ищет записи, ссылающиеся на удалённые файлы: деинсталляция, пути приложений, общие DLL, COM, библиотеки типов, автозагрузка, брандмауэр. Всё исправленное возвращается из Центра отмены."/>
            </StackPanel>
        </DockPanel>
        <!-- summary and the found problems per category; the last cell is when the registry was last checked -->
        <Grid DockPanel.Dock="Top" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Card}" Padding="20,18" Margin="0,0,12,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Найдено проблем" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="CountText" Text="-" Style="{StaticResource Figure}"/>
                    <TextBlock x:Name="SafeText" Style="{StaticResource Caption}"/>
                </StackPanel>
            </ContentControl>
            <ItemsControl x:Name="Tiles" Grid.Column="1" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type m:RegTile}">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,8,8" ToolTip="{Binding Name}">
                            <DockPanel>
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Surface2Brush}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="{StaticResource IconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CountText}" FontSize="17" FontWeight="Bold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <Grid Margin="0,0,8,8">
                            <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource DashBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Margin="12,0">
                                <Run Text="&#xE823;" FontFamily="{StaticResource Icons}"/> <Run Text="{Binding Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </Grid>
        <!-- search; the commands for the selected row, the rest under "⋯" -->
        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Добавить в исключения" Style="{StaticResource Ghost}" Click="Ignore_Click" ToolTip="Выбранные записи больше не будут показываться"/>
                <Button Content="Открыть ключ" Style="{StaticResource Ghost}" Click="Open_Click" ToolTip="Ключ в редакторе реестра"/>
                <Button Style="{StaticResource More}" Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Отметить все" Tag="&#xE73A;" Click="All_Click"/>
                            <MenuItem Header="Снять все" Tag="&#xE739;" Click="None_Click"/>
                            <Separator/>
                            <MenuItem Header="Список исключений" Tag="&#xE8FD;" Click="IgnoreList_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Width="290" HorizontalAlignment="Left" TextChanged="Search_TextChanged" ToolTip="Поиск по категории, ключу и проблеме"/>
        </DockPanel>
        <Grid>
        <DataGrid x:Name="Grid" SelectionMode="Extended" MouseDoubleClick="Open_Click">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                <!-- the key in mono over what is wrong with it -->
                <DataGridTemplateColumn Header="Запись" SortMemberPath="Display" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Display}">
                                <TextBlock Text="{Binding Display}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource MonoSize}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Problem}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" IsReadOnly="True" Width="180" ElementStyle="{StaticResource CellTrim}"/>
                <!-- a soft tag with a tick for references nothing reads any more, an outline tag with an eye for the ones worth a look -->
                <DataGridTemplateColumn Header="Оценка" SortMemberPath="Safe" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="tag" Height="{StaticResource TagHeight}" CornerRadius="{StaticResource RTag}" Padding="8,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                                <Grid TextElement.FontSize="12.5" TextElement.Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                    <StackPanel x:Name="check" Orientation="Horizontal"><TextBlock Text="&#xE7B3;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock rk:L.Text="Проверить"/></StackPanel>
                                    <StackPanel x:Name="safe" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock rk:L.Text="Безопасно"/></StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Safe}" Value="True">
                                    <Setter TargetName="tag" Property="Background" Value="{DynamicResource TagBrush}"/>
                                    <Setter TargetName="tag" Property="BorderBrush" Value="Transparent"/>
                                    <Setter TargetName="check" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="safe" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock Style="{StaticResource GridEmpty}" Tag="{Binding ElementName=Grid}" Text="Проблем не найдено. Нажмите «Сканировать», чтобы проверить реестр."/>
            <ContentControl x:Name="Bar" Style="{StaticResource SelectionBar}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="BarText" Style="{StaticResource BarCount}" Margin="0"/>
                        <TextBlock Style="{StaticResource Reversible}" Margin="0"><Run Text="&#xE7A7;" FontFamily="{StaticResource Icons}"/> <Run Text="Всё можно вернуть из Центра отмены"/></TextBlock>
                    </StackPanel>
                    <Button Content="Снять все" Click="None_Click"/>
                    <Border Style="{StaticResource DockRule}"/>
                    <Button Content="Исправить" Style="{StaticResource Primary}" Margin="0" Click="Fix_Click"/>
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
