<UserControl x:Class="RegKeeper.Modules.RegCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- header: title and description, the counter on the right -->
        <DockPanel DockPanel.Dock="Top">
            <ContentControl DockPanel.Dock="Right" Style="{StaticResource Metric}">
                <StackPanel><TextBlock Text="Проблем" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CountText" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
            </ContentControl>
            <StackPanel>
                <TextBlock Text="Чистка реестра" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Ищет записи, ссылающиеся на удалённые файлы: деинсталляция, пути приложений, общие DLL, COM, библиотеки типов, автозагрузка, брандмауэр. Всё исправленное возвращается из Центра отмены."/>
            </StackPanel>
        </DockPanel>
        <!-- toolbar: one row; rarer commands under "⋯", fixing in the selection bar -->
        <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Toolbar}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Сканировать" Style="{StaticResource Primary}" Click="Scan_Click"/>
                <Button Style="{StaticResource More}" Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Отметить все" Tag="&#xE73A;" Click="All_Click"/>
                            <MenuItem Header="Снять все" Tag="&#xE739;" Click="None_Click"/>
                            <Separator/>
                            <MenuItem Header="Ключ в редакторе" Tag="&#xE8A7;" Click="Open_Click"/>
                            <MenuItem Header="В исключения" Tag="&#xE8F8;" ToolTip="Выбранные записи больше не будут показываться" Click="Ignore_Click"/>
                            <MenuItem Header="Список исключений" Tag="&#xE8FD;" Click="IgnoreList_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition MaxWidth="420"/></Grid.ColumnDefinitions>
                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged" ToolTip="Поиск по категории, ключу и проблеме"/>
            </Grid>
        </DockPanel>
        <Grid>
        <DataGrid x:Name="Grid" SelectionMode="Extended" MouseDoubleClick="Open_Click">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Ключ" Binding="{Binding Display}" IsReadOnly="True" Width="3*"/>
                <DataGridTextColumn Header="Проблема" Binding="{Binding Problem}" IsReadOnly="True" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock Style="{StaticResource GridEmpty}" Tag="{Binding ElementName=Grid}" Text="Проблем не найдено. Нажмите «Сканировать», чтобы проверить реестр."/>
            <ContentControl x:Name="Bar" Style="{StaticResource SelectionBar}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BarText" Style="{StaticResource BarCount}"/>
                    <TextBlock Style="{StaticResource Reversible}"><Run Text="&#xE7A7;" FontFamily="{StaticResource Icons}"/> <Run Text="Всё можно вернуть из Центра отмены"/></TextBlock>
                    <Button Content="Снять все" Style="{StaticResource Small}" Click="None_Click"/>
                    <Button Content="Исправить" Style="{StaticResource SmallDanger}" Margin="0" Click="Fix_Click"/>
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
