<UserControl x:Class="RegKeeper.Modules.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,24">
            <TextBlock Text="Настройки" Style="{StaticResource Title}"/>
            <TextBlock Style="{StaticResource Lead}" Text="Оформление, поведение окна, интеграция с Windows и обновления."/>
            <!-- two columns of cards; in a narrow window the second column drops under the first -->
            <WrapPanel Margin="0,20,0,0">
            <StackPanel Width="460" Margin="0,0,16,0">
                <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Оформление" Style="{StaticResource Section}" Margin="0,0,0,14"/>
                                <TextBlock Text="Тема" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource Segments}">
                                    <Grid>
                                        <Canvas><Border x:Name="ThemePill" Style="{StaticResource Pill}"/></Canvas>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeSystem" Content="Как в Windows" Tag="System" Checked="Theme_Checked"/>
                                            <RadioButton x:Name="ThemeLight" Content="Светлая" Tag="Light" Checked="Theme_Checked"/>
                                            <RadioButton x:Name="ThemeDark" Content="Тёмная" Tag="Dark" Checked="Theme_Checked"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Масштаб интерфейса" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                                <Border Style="{StaticResource Segments}">
                                    <Grid>
                                        <Canvas><Border x:Name="ScalePill" Style="{StaticResource Pill}"/></Canvas>
                                        <StackPanel x:Name="ScaleChoices" Orientation="Horizontal"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Язык" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                                <Border Style="{StaticResource Segments}">
                                    <Grid>
                                        <Canvas><Border x:Name="LangPill" Style="{StaticResource Pill}"/></Canvas>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangAuto" Content="Как в Windows" Tag="Auto" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangRu" Content="Русский" Tag="ru" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangEn" Content="English" Tag="en" Checked="Lang_Checked"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Поведение" Style="{StaticResource Section}" Margin="0,0,0,14"/>
                                <TextBlock Text="При закрытии окна" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource Segments}">
                                    <Grid>
                                        <Canvas><Border x:Name="ClosePill" Style="{StaticResource Pill}"/></Canvas>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="CloseExit" Content="Закрывать программу" Checked="Close_Checked"/>
                                            <RadioButton x:Name="CloseTray" Content="Сворачивать в трей" Checked="Close_Checked"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <CheckBox x:Name="BackupCard" Style="{StaticResource Switch}" Margin="0,18,0,0" Checked="BackupCard_Changed" Unchecked="BackupCard_Changed"><TextBlock Text="Карточка «Резервная копия реестра» внизу боковой панели" TextWrapping="Wrap"/></CheckBox>
                                <CheckBox x:Name="Lite" Style="{StaticResource Switch}" Margin="0,14,0,0" Checked="Lite_Changed" Unchecked="Lite_Changed"><TextBlock Text="Лёгкий режим: без анимаций, подсветки и теней" TextWrapping="Wrap"/></CheckBox>
                                <TextBlock Style="{StaticResource Hint}" Margin="42,4,0,0" TextWrapping="Wrap" Text="Для слабых компьютеров и удалённого рабочего стола. Включается после перезапуска RegKeeper."/>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
            <StackPanel Width="460">
                <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Интеграция с Windows" Style="{StaticResource Section}" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ShellVerb" Style="{StaticResource Switch}" Margin="0,0,0,0" Checked="ShellVerb_Changed" Unchecked="ShellVerb_Changed"><TextBlock Text="Пункт «Удалить с RegKeeper» в контекстном меню exe-файлов и ярлыков" TextWrapping="Wrap"/></CheckBox>
                                <TextBlock Style="{StaticResource Hint}" Margin="42,4,0,0" TextWrapping="Wrap" Text="В Windows 11 пункт находится в «Показать дополнительные параметры». Только для текущего пользователя."/>
                                <CheckBox x:Name="Watcher" Style="{StaticResource Switch}" Margin="0,16,0,0" Checked="Watcher_Changed" Unchecked="Watcher_Changed"><TextBlock Text="Следить за автозагрузкой и предупреждать о новых программах" TextWrapping="Wrap"/></CheckBox>
                                <TextBlock Style="{StaticResource Hint}" Margin="42,4,0,0" TextWrapping="Wrap" Text="Маленькая программа в трее (RegKeeper.Watcher) запускается при входе в систему и проверяет ключи Run и папки автозагрузки."/>
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Данные" Style="{StaticResource Section}" Margin="0,0,0,14"/>
                        <TextBlock x:Name="DataInfo" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Открыть папку данных" Margin="0" Click="Data_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="О программе" Style="{StaticResource Section}" Margin="0,0,0,14"/>
                        <TextBlock x:Name="About" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="UpdateInfo" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="UpdateBtn" Content="Проверить обновления" Style="{StaticResource Primary}" Click="Update_Click"/>
                            <Button Content="Обновить из файла" Margin="0" Click="UpdateFile_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
