<UserControl x:Class="RegKeeper.Modules.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rk="clr-namespace:RegKeeper">
    <UserControl.Resources>
        <!-- a theme in miniature: side rail, a card with two lines and a button; the brushes come from the theme the code puts on it -->
        <ControlTemplate x:Key="Preview" TargetType="ContentControl">
            <Grid Width="116" Height="70" Background="{DynamicResource BgBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Background="{DynamicResource SideBrush}">
                    <Rectangle Height="3" Margin="6,10,6,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource PrimaryBrush}"/>
                    <Rectangle Height="3" Margin="6,6,6,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource FaintBrush}"/>
                    <Rectangle Height="3" Margin="6,6,6,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource FaintBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Margin="7" Padding="7,6" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                    <StackPanel>
                        <Rectangle Height="4" Width="36" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextBrush}"/>
                        <Rectangle Height="3" Width="52" Margin="0,5,0,0" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource MutedBrush}"/>
                        <Border Height="10" Width="28" Margin="0,8,0,0" HorizontalAlignment="Left" CornerRadius="5" Background="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ControlTemplate>
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Padding="5" CornerRadius="14" BorderThickness="1.5" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PendingEdgeBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PendingEdgeBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,24">
            <!-- header: title, description; the real version on the right -->
            <DockPanel>
                <ContentPresenter x:Name="VersionTag" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,14,0,0" ContentTemplate="{StaticResource OutlineBadge}"/>
                <StackPanel>
                    <TextBlock Text="Настройки" Style="{StaticResource Title}"/>
                    <TextBlock Style="{StaticResource Lead}" Text="Оформление, поведение окна, интеграция с Windows и обновления."/>
                </StackPanel>
            </DockPanel>
            <!-- two columns of cards; in a narrow window the second drops under the first (code) -->
            <Grid x:Name="Cols" Margin="0,20,0,0" SizeChanged="Cols_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Оформление" Style="{StaticResource Section}" Margin="0,0,0,14"/>
                            <TextBlock Text="Тема" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <RadioButton x:Name="ThemeSystem" Tag="System" Style="{StaticResource ThemeCard}" Checked="Theme_Checked" rk:L.Tip="Как в Windows">
                                    <StackPanel>
                                        <Border Width="116" Height="70">
                                            <Border.Clip><RectangleGeometry Rect="0,0,116,70" RadiusX="9" RadiusY="9"/></Border.Clip>
                                            <Grid>
                                                <ContentControl x:Name="SystemLight" Template="{StaticResource Preview}" Focusable="False"/>
                                                <ContentControl x:Name="SystemDark" Template="{StaticResource Preview}" Focusable="False" Clip="M58,0 H116 V70 H58 Z"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Как в Windows" Margin="4,8,0,3"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ThemeLight" Tag="Light" Style="{StaticResource ThemeCard}" Checked="Theme_Checked" rk:L.Tip="Светлая">
                                    <StackPanel>
                                        <Border Width="116" Height="70">
                                            <Border.Clip><RectangleGeometry Rect="0,0,116,70" RadiusX="9" RadiusY="9"/></Border.Clip>
                                            <ContentControl x:Name="LightPreview" Template="{StaticResource Preview}" Focusable="False"/>
                                        </Border>
                                        <TextBlock Text="Светлая" Margin="4,8,0,3"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ThemeDark" Tag="Dark" Style="{StaticResource ThemeCard}" Checked="Theme_Checked" rk:L.Tip="Тёмная">
                                    <StackPanel>
                                        <Border Width="116" Height="70">
                                            <Border.Clip><RectangleGeometry Rect="0,0,116,70" RadiusX="9" RadiusY="9"/></Border.Clip>
                                            <ContentControl x:Name="DarkPreview" Template="{StaticResource Preview}" Focusable="False"/>
                                        </Border>
                                        <TextBlock Text="Тёмная" Margin="4,8,0,3"/>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                            <TextBlock Text="Масштаб интерфейса" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                            <Border Style="{StaticResource Segments}">
                                <Grid>
                                    <Canvas><Border x:Name="ScalePill" Style="{StaticResource Pill}"/></Canvas>
                                    <StackPanel x:Name="ScaleChoices" Orientation="Horizontal"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Язык" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                            <Border Style="{StaticResource Segments}">
                                <Grid>
                                    <Canvas><Border x:Name="LangPill" Style="{StaticResource Pill}"/></Canvas>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LangAuto" Content="Как в Windows" Tag="Auto" Checked="Lang_Checked"/>
                                        <RadioButton x:Name="LangRu" Content="Русский" Tag="ru" Checked="Lang_Checked"/>
                                        <RadioButton x:Name="LangEn" Content="English" Tag="en" Checked="Lang_Checked"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Поведение" Style="{StaticResource Section}" Margin="0,0,0,14"/>
                            <TextBlock Text="При закрытии окна" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource Segments}">
                                <Grid>
                                    <Canvas><Border x:Name="ClosePill" Style="{StaticResource Pill}"/></Canvas>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CloseExit" Content="Закрывать программу" Checked="Close_Checked"/>
                                        <RadioButton x:Name="CloseTray" Content="Сворачивать в трей" Checked="Close_Checked"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <CheckBox x:Name="BackupCard" Style="{StaticResource Switch}" Margin="0,18,0,0" Checked="BackupCard_Changed" Unchecked="BackupCard_Changed"><TextBlock Text="Карточка «Резервная копия реестра» внизу боковой панели" TextWrapping="Wrap"/></CheckBox>
                            <CheckBox x:Name="Lite" Style="{StaticResource Switch}" Margin="0,14,0,0" Checked="Lite_Changed" Unchecked="Lite_Changed"><TextBlock Text="Лёгкий режим: без анимаций, подсветки и теней" TextWrapping="Wrap"/></CheckBox>
                            <TextBlock Style="{StaticResource Hint}" Margin="42,4,0,0" Text="Для слабых компьютеров и удалённого рабочего стола. Включается после перезапуска RegKeeper."/>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
                <StackPanel x:Name="Right" Grid.Column="2">
                    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Интеграция с Windows" Style="{StaticResource Section}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ShellVerb" Style="{StaticResource Switch}" Checked="ShellVerb_Changed" Unchecked="ShellVerb_Changed"><TextBlock Text="Пункт «Удалить с RegKeeper» в контекстном меню exe-файлов и ярлыков" TextWrapping="Wrap"/></CheckBox>
                            <TextBlock Style="{StaticResource Hint}" Margin="42,4,0,0" Text="В Windows 11 пункт находится в «Показать дополнительные параметры». Только для текущего пользователя."/>
                            <CheckBox x:Name="Watcher" Style="{StaticResource Switch}" Margin="0,16,0,0" Checked="Watcher_Changed" Unchecked="Watcher_Changed"><TextBlock Text="Следить за автозагрузкой и предупреждать о новых программах" TextWrapping="Wrap"/></CheckBox>
                            <TextBlock Style="{StaticResource Hint}" Margin="42,4,0,0" Text="Маленькая программа в трее (RegKeeper.Watcher) запускается при входе в систему и проверяет ключи Run и папки автозагрузки."/>
                        </StackPanel>
                    </ContentControl>
                    <!-- data: total, where it lives, what takes the space -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Открыть папку" Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Top" Click="Data_Click"/>
                                <TextBlock Text="Данные" Style="{StaticResource Section}" Margin="0"/>
                            </DockPanel>
                            <TextBlock x:Name="DataSize" FontSize="32" FontWeight="Bold"/>
                            <TextBlock x:Name="DataPath" Style="{StaticResource MonoText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,14"/>
                            <Border x:Name="UsageBox" Height="8" CornerRadius="4" Background="{DynamicResource Surface3Brush}">
                                <Grid x:Name="Usage"/>
                            </Border>
                            <ItemsControl x:Name="UsageLegend" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Size}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ContentControl>
                    <!-- updates: the version on the machine, the automatic check stays on -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Обновления" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="About" FontSize="22" FontWeight="Bold"/>
                            <TextBlock x:Name="Runtime" Style="{StaticResource Caption}" Margin="0,2,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Проверяются автоматически: при запуске и каждые 6 часов" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateInfo" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="UpdateBtn" Content="Проверить обновления" Style="{StaticResource Primary}" Click="Update_Click"/>
                                <Button Content="Обновить из файла" Margin="0" Click="UpdateFile_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
