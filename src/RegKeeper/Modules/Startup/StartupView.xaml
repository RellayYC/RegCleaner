<UserControl x:Class="RegKeeper.Modules.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- header: title and description, the counters on the right -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Записей" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CountText" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Включено" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="OnText" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Битых" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="MissingText" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Автозагрузка" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Ключи Run, папки автозагрузки, задачи планировщика при входе/старте и сторонние службы. Отключение обратимо, всё пишется в Центр отмены."/>
            </StackPanel>
        </DockPanel>
        <!-- toolbar: one row; rarer commands under "⋯", deleting in the selection bar -->
        <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Toolbar}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <CheckBox x:Name="ShowServices" Content="Службы" Style="{StaticResource Chip}" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ShowTasks" Content="Задачи" Style="{StaticResource Chip}" IsChecked="True" Margin="0,0,12,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <Button Content="Вкл / выкл" Style="{StaticResource Primary}" Click="Toggle_Click"/>
                <Button Content="Отложить" Click="Delay_Click" ToolTip="Запускать через заданное время после входа в Windows (задачей планировщика)"/>
                <Button Content="&#xE72C;" Style="{StaticResource IconBtn}" ToolTip="Обновить" AutomationProperties.Name="Обновить" Click="Refresh_Click"/>
                <Button Style="{StaticResource More}" Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Добавить" Tag="&#xE710;" Click="Add_Click"/>
                            <Separator/>
                            <MenuItem Header="Папка файла" Tag="&#xE838;" Click="Folder_Click"/>
                            <MenuItem Header="Перейти к записи" Tag="&#xE8A7;" Click="Goto_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition MaxWidth="420"/></Grid.ColumnDefinitions>
                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged" ToolTip="Поиск по названию, команде и издателю"/>
            </Grid>
        </DockPanel>
        <Grid>
        <DataGrid x:Name="Grid" IsReadOnly="True" SelectionMode="Extended" MouseDoubleClick="Toggle_Click">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Вкл" SortMemberPath="Enabled" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}" Click="Switch_Click" AutomationProperties.Name="Вкл / выкл"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Width="62" CellTemplate="{StaticResource AppIcon}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                <DataGridTemplateColumn Header="Тип" SortMemberPath="KindText" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding KindText}" ContentTemplate="{StaticResource Badge}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Издатель" Binding="{Binding Publisher}" Width="*"/>
                <DataGridTextColumn Header="Команда" Binding="{Binding Command}" Width="3*"/>
                <DataGridTemplateColumn Header="Статус" SortMemberPath="Missing" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource DangerBadge}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock Style="{StaticResource GridEmpty}" Tag="{Binding ElementName=Grid}" Text="Ничего не найдено. Измените запрос или фильтры."/>
            <ContentControl x:Name="Bar" Style="{StaticResource SelectionBar}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BarText" Style="{StaticResource BarCount}"/>
                    <TextBlock Style="{StaticResource Reversible}"><Run Text="&#xE7A7;" FontFamily="{StaticResource Icons}"/> <Run Text="Всё можно вернуть из Центра отмены"/></TextBlock>
                    <Button Content="Вкл / выкл" Style="{StaticResource SmallPrimary}" Click="Toggle_Click"/>
                    <Button Content="Удалить" Style="{StaticResource SmallDanger}" Margin="0" Click="Delete_Click"/>
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
