<UserControl x:Class="RegKeeper.Modules.SnapshotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Снимки и отслеживание установок" Style="{StaticResource Title}"/>
            <TextBlock Style="{StaticResource Lead}" Text="Снимок фиксирует разделы реестра и файлы. Сравнение двух снимков показывает, что изменилось; отслеживание установки делает снимки до и после инсталлятора и сохраняет разницу, чтобы потом откатить ровно её."/>
            <DockPanel Margin="{StaticResource Toolbar}">
                <TextBlock Text="Что снимать:" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox x:Name="Roots" ToolTip="Разделы реестра и папки через ;"/>
            </DockPanel>
            <WrapPanel Margin="0,0,0,6">
                <Button Content="Сделать снимок" Style="{StaticResource Primary}" Click="Take_Click"/>
                <Button Content="Сравнить два выбранных" Click="Compare_Click"/>
                <Button Content="Отследить установку..." Style="{StaticResource Primary}" Click="Trace_Click"/>
                <Button Content="Показать трассу" Click="ShowTrace_Click"/>
                <Button Content="Удалить" Click="Delete_Click"/>
                <Button Content="Папка с данными" Click="Folder_Click"/>
            </WrapPanel>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="250"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="SnapList" SelectionMode="Extended" IsReadOnly="True" Margin="0,0,9,0" GotFocus="List_GotFocus">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Снимок" Binding="{Binding Note}" Width="2*"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="120"/>
                    <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="TraceList" Grid.Column="1" SelectionMode="Single" IsReadOnly="True" Margin="9,0,0,0"
                      GotFocus="List_GotFocus" MouseDoubleClick="ShowTrace_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Отслеженная установка" Binding="{Binding Note}" Width="2*"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,24,0,14">
                <TextBlock x:Name="Status" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                <WrapPanel>
                    <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Width="420" Margin="0,0,8,0" TextChanged="Search_TextChanged" ToolTip="Фильтр по пути"/>
                    <Button Content="Откатить отмеченное" Style="{StaticResource DangerBtn}" Click="Rollback_Click"
                            ToolTip="Удалить добавленное, вернуть изменённые и удалённые значения реестра. Добавленные файлы уходят в корзину."/>
                    <Button Content="Отметить все" Click="All_Click"/>
                    <Button Content="Снять все" Click="None_Click"/>
                    <Button Content="Показать" Click="Open_Click"/>
                </WrapPanel>
            </DockPanel>
            <DataGrid x:Name="Changes" Grid.Row="2" Grid.ColumnSpan="2" SelectionMode="Extended" MouseDoubleClick="Open_Click">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                    <DataGridTextColumn Header="Изменение" Binding="{Binding KindText}" IsReadOnly="True" Width="170"/>
                    <DataGridTextColumn Header="Путь" Binding="{Binding Display}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
