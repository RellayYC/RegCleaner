<UserControl x:Class="RegKeeper.Modules.UndoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- header: title and description, the counters on the right -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Записей" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CountText" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Занимают" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="SizeText" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Центр отмены" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Каждое изменение реестра и задач планировщика сохраняется здесь до применения. Отмена возвращает всё как было и убирает запись. Файлы и папки удаляются в корзину, восстанавливайте их оттуда."/>
            </StackPanel>
        </DockPanel>
        <!-- toolbar: Undo on the right, housekeeping under "⋯"; deleting a record is in the selection bar -->
        <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Toolbar}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Отменить изменения" Style="{StaticResource Primary}" Click="Restore_Click"/>
                <Button Content="&#xE72C;" Style="{StaticResource IconBtn}" ToolTip="Обновить" AutomationProperties.Name="Обновить" Click="Refresh_Click"/>
                <Button Style="{StaticResource More}" Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Открыть .reg" Tag="&#xE8E5;" ToolTip="Резервная копия в формате regedit" Click="OpenReg_Click"/>
                            <Separator/>
                            <MenuItem Header="Удалить старше 30 дней" Tag="&#xE74D;" Click="DeleteOld_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Text="Новые записи сверху. Отмена идёт от новых к старым."/>
        </DockPanel>
        <!-- what the selected record brings back -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=Grid}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
            </DockPanel.Style>
            <TextBlock DockPanel.Dock="Top" Text="Что вернёт отмена" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
            <ListBox x:Name="Items" Height="180" ItemsSource="{Binding SelectedItem.Items, ElementName=Grid}"/>
        </DockPanel>
        <Grid>
            <DataGrid x:Name="Grid" IsReadOnly="True" MouseDoubleClick="Restore_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Когда" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm:ss}" SortMemberPath="Date" Width="180"/>
                    <DataGridTextColumn Header="Операция" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Изменений" Binding="{Binding Count}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource GridEmpty}" Tag="{Binding ElementName=Grid}" Text="Изменений пока нет. Всё, что меняет RegKeeper, появится здесь."/>
            <ContentControl x:Name="Bar" Style="{StaticResource SelectionBar}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BarText" Style="{StaticResource BarCount}"/>
                    <Button Content="Отменить" Style="{StaticResource SmallPrimary}" Click="Restore_Click"/>
                    <Button Content="Удалить запись" Style="{StaticResource SmallDanger}" Margin="0" Click="Delete_Click" ToolTip="Эти изменения больше нельзя будет отменить"/>
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
