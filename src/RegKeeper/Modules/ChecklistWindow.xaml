<Window x:Class="RegKeeper.Modules.ChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="520" Width="900" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock x:Name="Header" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Отметить все" Click="All_Click"/>
                <Button Content="Снять все" Click="None_Click"/>
                <Button Content="Показать" Click="Reveal_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Удалить отмеченное" Style="{StaticResource Primary}" Click="Ok_Click"/>
                <Button Content="Закрыть" IsCancel="True" Margin="0"/>
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="Grid">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Путь" Binding="{Binding Path}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" IsReadOnly="True" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
