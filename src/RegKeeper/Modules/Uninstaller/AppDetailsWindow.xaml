<Window x:Class="RegKeeper.Modules.AppDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <!-- the app: icon tile, name and version -->
        <DockPanel Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="{StaticResource RControl}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center"
                    Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource TileEdgeBrush}">
                <Image x:Name="Ico" Width="28" Height="28"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AppName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="AppVersion" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <!-- facts, one per row -->
        <ContentControl Style="{StaticResource Card}" Padding="16,4">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="0,10"/>
                    </Style>
                    <Style x:Key="K" TargetType="TextBlock">
                        <Setter Property="Width" Value="150"/>
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style>
                </StackPanel.Resources>
                <Border>
                    <DockPanel>
                        <TextBlock Text="Файл" Style="{StaticResource K}"/>
                        <Button x:Name="Go" Content="Перейти" DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Center" Click="Go_Click"/>
                        <TextBlock x:Name="FilePath" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource MonoText}"/>
                    </DockPanel>
                </Border>
                <Border>
                    <DockPanel>
                        <TextBlock Text="Размер файла" Style="{StaticResource K}"/>
                        <TextBlock x:Name="FileSize" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border>
                    <DockPanel>
                        <TextBlock Text="Размер программы" Style="{StaticResource K}"/>
                        <TextBlock x:Name="AppSize" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border>
                    <DockPanel>
                        <TextBlock Text="Установлена для" Style="{StaticResource K}"/>
                        <TextBlock x:Name="ForUser" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border>
                    <DockPanel>
                        <TextBlock Text="Издатель" Style="{StaticResource K}"/>
                        <TextBlock x:Name="Author" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border>
                    <DockPanel>
                        <TextBlock Text="Дата установки" Style="{StaticResource K}"/>
                        <TextBlock x:Name="Date" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border BorderThickness="0">
                    <DockPanel>
                        <TextBlock Text="Ключ реестра" Style="{StaticResource K}"/>
                        <TextBlock x:Name="KeyPath" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource MonoText}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ContentControl>
        <Button Content="Закрыть" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
