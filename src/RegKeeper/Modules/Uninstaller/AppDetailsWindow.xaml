<Window x:Class="RegKeeper.Modules.AppDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <DockPanel Margin="0,0,0,16">
            <Image x:Name="Ico" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AppName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="AppVersion" Style="{StaticResource Hint}"/>
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.Resources>
                <Style x:Key="K" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                    <Setter Property="Margin" Value="0,0,16,10"/>
                </Style>
                <Style x:Key="V" TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Файл" Style="{StaticResource K}" VerticalAlignment="Center"/>
            <DockPanel Grid.Column="1" Margin="0,0,0,10">
                <Button x:Name="Go" Content="Перейти" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" Click="Go_Click"/>
                <TextBlock x:Name="FilePath" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="Размер файла" Style="{StaticResource K}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FileSize" Style="{StaticResource V}"/>
            <TextBlock Grid.Row="2" Text="Размер программы" Style="{StaticResource K}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AppSize" Style="{StaticResource V}"/>
            <TextBlock Grid.Row="3" Text="Установлена для" Style="{StaticResource K}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ForUser" Style="{StaticResource V}"/>
            <TextBlock Grid.Row="4" Text="Издатель" Style="{StaticResource K}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="Author" Style="{StaticResource V}"/>
            <TextBlock Grid.Row="5" Text="Дата установки" Style="{StaticResource K}"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="Date" Style="{StaticResource V}"/>
            <TextBlock Grid.Row="6" Text="Ключ реестра" Style="{StaticResource K}"/>
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="KeyPath" Style="{StaticResource V}"/>
        </Grid>
        <Button Content="Закрыть" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
