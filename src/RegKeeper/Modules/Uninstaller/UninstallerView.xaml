<UserControl x:Class="RegKeeper.Modules.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rk="clr-namespace:RegKeeper">
    <DockPanel>
        <!-- header: title and description; export and refresh on the right, the uninstall commands live in the dock -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Экспорт" Style="{StaticResource Ghost}" Click="Export_Click" ToolTip="Список программ в CSV"/>
                <Button Content="&#xE72C;" Style="{StaticResource IconBtn}" Margin="0" ToolTip="Обновить" AutomationProperties.Name="Обновить" Click="Refresh_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Удаление программ" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Запускает штатный деинсталлятор, затем ищет оставшиеся папки и ключи реестра. Ключи уходят в Центр отмены, папки в корзину."/>
            </StackPanel>
        </DockPanel>
        <!-- where the space goes: a treemap of the biggest programs; a block and its row share the tick -->
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,14,18,18">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Border DockPanel.Dock="Right" Style="{StaticResource Segments}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BySize" Style="{StaticResource Segment}" Content="Размер" IsChecked="True" Checked="MapMode_Checked"/>
                            <RadioButton x:Name="ByIdle" Style="{StaticResource Segment}" Content="Давно не запускались" Checked="MapMode_Checked"
                                         ToolTip="Не запускались 90 дней и дольше (по данным Prefetch)"/>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Где занято место" Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock x:Name="CountText" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </DockPanel>
                <Canvas x:Name="Map" Tag="data" Height="168" ClipToBounds="True" SizeChanged="Map_SizeChanged"/>
            </DockPanel>
        </ContentControl>
        <!-- search and the quick filters -->
        <DockPanel DockPanel.Dock="Top" Margin="0,18,0,12">
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Width="290" Margin="0,0,14,0" TextChanged="Search_TextChanged" ToolTip="Поиск по названию и издателю"/>
            <StackPanel x:Name="Chips" Orientation="Horizontal">
                <CheckBox Style="{StaticResource Chip}" Content="Все" Tag="all" IsChecked="True" Click="Chip_Click"/>
                <CheckBox Style="{StaticResource Chip}" Content="Большие" Tag="big" Click="Chip_Click" ToolTip="Больше 1 ГБ"/>
                <CheckBox Style="{StaticResource Chip}" Content="Недавние" Tag="new" Click="Chip_Click" ToolTip="Установлены за последние 30 дней"/>
                <CheckBox Style="{StaticResource Chip}" Content="Только мои" Tag="mine" Click="Chip_Click" ToolTip="Установлены только для текущего пользователя"/>
            </StackPanel>
        </DockPanel>
        <Grid>
        <DataGrid x:Name="Grid" SelectionMode="Single" MouseDoubleClick="Grid_DoubleClick" ContextMenuOpening="Grid_ContextMenuOpening">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MenuCheck" Header="Выбрать" Tag="&#xE73E;" Click="Check_Click"/>
                    <MenuItem x:Name="MenuUninstall" Header="Удалить" Tag="&#xE74D;" Click="Uninstall_Click"/>
                    <MenuItem x:Name="MenuFav" Header="В избранное" Tag="&#xE734;" Click="Fav_Click"/>
                    <MenuItem x:Name="MenuRun" Header="Запустить" Tag="&#xE768;" Click="Run_Click"/>
                    <Separator/>
                    <MenuItem Header="Папка" Tag="&#xE838;" Click="Folder_Click"/>
                    <MenuItem Header="Ключ в редакторе" Tag="&#xE8A7;" Click="Key_Click"/>
                    <MenuItem Header="Подробнее..." Tag="&#xE946;" Click="Details_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                <DataGridTemplateColumn Width="58" CellTemplate="{StaticResource AppIcon}" IsReadOnly="True"/>
                <!-- name over publisher; favourites carry a filled star before the name -->
                <DataGridTemplateColumn Header="Название" SortMemberPath="Name" Width="3*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel>
                                    <TextBlock x:Name="star" Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,6,0"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Favorite}" Value="True"><Setter TargetName="star" Property="Visibility" Value="Visible"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn IsReadOnly="True" Header="Версия" Binding="{Binding Version}" Width="130" ElementStyle="{StaticResource CellTrim}"/>
                <DataGridTextColumn IsReadOnly="True" Header="Размер" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="100"/>
                <DataGridTextColumn IsReadOnly="True" Header="Запуск" Binding="{Binding LastRunText}" SortMemberPath="LastRun" Width="120"/>
                <DataGridTemplateColumn IsReadOnly="True" Header="Для кого" SortMemberPath="Scope" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Scope}" ContentTemplate="{StaticResource Badge}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Width="52" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE712;" Width="32" MinHeight="32" Height="32" Margin="0"
                                    rk:L.Tip="Ещё" Click="RowMore_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock Style="{StaticResource GridEmpty}" Tag="{Binding ElementName=Grid}" Text="Ничего не найдено. Измените запрос."/>
            <!-- ticked or selected programs: the uninstall commands; the irreversible one after the rule -->
            <ContentControl x:Name="Bar" Style="{StaticResource SelectionBar}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="BarText" Style="{StaticResource BarCount}" Margin="0"/>
                        <TextBlock Style="{StaticResource Reversible}" Margin="0"><Run Text="&#xE7A7;" FontFamily="{StaticResource Icons}"/> <Run Text="Следы в реестре можно вернуть"/></TextBlock>
                    </StackPanel>
                    <Button Content="Удалить" Style="{StaticResource Primary}" Click="Uninstall_Click"/>
                    <Button Content="Тихо" Click="Quiet_Click" ToolTip="QuietUninstallString / msiexec /qb, если есть"/>
                    <Button Style="{StaticResource More}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Убрать запись" Tag="&#xE894;" ToolTip="Удалить только запись из списка (ключ Uninstall)" Click="RemoveEntry_Click"/>
                                <MenuItem Header="Папка" Tag="&#xE838;" Click="Folder_Click"/>
                                <MenuItem Header="Ключ в редакторе" Tag="&#xE8A7;" Click="Key_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Border Style="{StaticResource DockRule}"/>
                    <Button Content="Принудительно" Style="{StaticResource DangerBtn}" Margin="0" Click="Force_Click" ToolTip="Без деинсталлятора: сразу поиск и удаление следов"/>
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
