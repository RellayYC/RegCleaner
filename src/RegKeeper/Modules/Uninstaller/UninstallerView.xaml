<UserControl x:Class="RegKeeper.Modules.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Удаление программ" Style="{StaticResource Title}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Запускает штатный деинсталлятор, затем ищет оставшиеся папки и ключи реестра. Ключи уходят в Центр отмены, папки в корзину."/>
            <DockPanel Margin="0,14,0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="Status" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="Search" Width="320" HorizontalAlignment="Left" TextChanged="Search_TextChanged" ToolTip="Поиск по названию и издателю"/>
            </DockPanel>
            <WrapPanel Margin="0,0,0,10">
                <Button Content="Удалить" Style="{StaticResource Primary}" Click="Uninstall_Click"/>
                <Button Content="Тихое удаление" Click="Quiet_Click" ToolTip="QuietUninstallString / msiexec /qb, если есть"/>
                <Button Content="Принудительно" Style="{StaticResource DangerBtn}" Click="Force_Click" ToolTip="Без деинсталлятора: сразу поиск и удаление следов"/>
                <Button Content="Убрать запись" Click="RemoveEntry_Click" ToolTip="Удалить только запись из списка (ключ Uninstall)"/>
                <Button Content="Папка" Click="Folder_Click"/>
                <Button Content="Ключ в редакторе" Click="Key_Click"/>
                <Button Content="Экспорт" Click="Export_Click"/>
                <Button Content="Обновить" Click="Refresh_Click"/>
            </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="Grid" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Uninstall_Click">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="38" CellTemplate="{StaticResource AppIcon}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="3*"/>
                <DataGridTextColumn Header="Издатель" Binding="{Binding Publisher}" Width="2*"/>
                <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="110"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="90"/>
                <DataGridTextColumn Header="Установлено" Binding="{Binding DateText}" SortMemberPath="InstallDate" Width="100"/>
                <DataGridTemplateColumn Header="Для" SortMemberPath="Scope" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Scope}" ContentTemplate="{StaticResource Badge}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
