<UserControl x:Class="RegKeeper.Modules.StoreAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="15">
    <!-- the page scrolls as a whole; the table card is sized to the viewport so the grid still virtualizes (Page_ScrollChanged) -->
    <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" ScrollChanged="Page_ScrollChanged">
        <StackPanel x:Name="Body" Margin="0,0,8,8">
            <TextBlock Text="Приложения Windows" Style="{StaticResource Title}"/>
            <TextBlock Style="{StaticResource Lead}" Text="Приложения из Microsoft Store и встроенные UWP-приложения текущего пользователя. Фреймворки и системные пакеты скрыты и не удаляются. Удалённое приложение можно вернуть только переустановкой из Store."/>

            <!-- four figures; two columns on a narrow window -->
            <UniformGrid x:Name="Widgets" Columns="4" Margin="0,28,-18,0">
                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap}">
                    <Grid>
                        <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Icons}" FontSize="110" Foreground="{DynamicResource TextBrush}" Opacity="0.05"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-18,-34"/>
                        <StackPanel>
                            <TextBlock Text="Приложения" Style="{StaticResource Caption}" FontSize="14"/>
                            <TextBlock x:Name="AppsFigure" Style="{StaticResource Figure}" Text="0" Margin="0,6,0,2"/>
                            <TextBlock x:Name="AppsNote" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Grid>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap}">
                    <DockPanel>
                        <!-- ring: share of the five largest apps -->
                        <Grid DockPanel.Dock="Right" Width="56" Height="56" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="6"/>
                            <Path x:Name="Ring" Stroke="{DynamicResource SegFirstBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Effect="{DynamicResource GlowLight}"/>
                            <TextBlock x:Name="RingText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Занято места" Style="{StaticResource Caption}" FontSize="14"/>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,6,0,2"><TextBlock x:Name="SpaceFigure" Style="{StaticResource Figure}"/></Viewbox>
                            <TextBlock x:Name="SpaceNote" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap}">
                    <StackPanel>
                        <TextBlock Text="Больше 500 МБ" Style="{StaticResource Caption}" FontSize="14"/>
                        <TextBlock x:Name="HeavyFigure" Style="{StaticResource Figure}" Text="0" Margin="0,6,0,8"/>
                        <StackPanel x:Name="HeavyBars"/>
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource HotCard}" Margin="{StaticResource Gap}">
                    <StackPanel>
                        <TextBlock Text="Можно освободить" Style="{StaticResource Caption}" FontSize="14" Foreground="{DynamicResource DangerTextBrush}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,6,0,2"><TextBlock x:Name="FreeFigure" Style="{StaticResource Figure}"/></Viewbox>
                        <TextBlock x:Name="FreeNote" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </ContentControl>
            </UniformGrid>

            <ContentControl Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock x:Name="SpaceTotal" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Что занимает место" FontSize="18" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Grid x:Name="Segments" Height="20"/>
                    <WrapPanel x:Name="Legend" Margin="0,16,0,0"/>
                </StackPanel>
            </ContentControl>

            <DockPanel Margin="0,24,0,18">
                <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="ShowSystem" Content="Показать системные" VerticalAlignment="Center" Margin="18,0,18,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <Button Content="Удалить" Style="{StaticResource DangerBtn}" Height="52" Margin="0,0,8,0" Padding="24,0" Click="Remove_Click"/>
                    <Button Content="Папка" Height="52" Margin="0,0,8,0" Padding="20,0" Click="Folder_Click"/>
                    <Button Content="Обновить" Height="52" Padding="20,0" Margin="0" Click="Refresh_Click"/>
                </StackPanel>
                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged" ToolTip="Поиск по названию, пакету и издателю"/>
            </DockPanel>

            <!-- table and details side by side; on a narrow window the details go under the table (Page_ScrollChanged) -->
            <Grid x:Name="Main">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="Grid" MinRowHeight="70" FontSize="15" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top"
                              SelectionChanged="Grid_SelectionChanged" ContextMenuOpening="Grid_ContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="MenuCheck" Header="Выбрать" Tag="&#xE73E;" Click="Check_Click"/>
                                <MenuItem x:Name="MenuRemove" Header="Удалить" Tag="&#xE74D;" Click="Remove_Click"/>
                                <MenuItem x:Name="MenuFav" Header="В избранное" Tag="&#xE734;" Click="Fav_Click"/>
                                <MenuItem x:Name="MenuRun" Header="Запустить" Tag="&#xE768;" Click="Run_Click"/>
                                <Separator/>
                                <MenuItem Header="Подробнее..." Tag="&#xE946;" Click="Details_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="44"/>
                            <DataGridTemplateColumn Header="Название" SortMemberPath="Title" Width="2*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppTile}" Margin="0,0,14,0"/>
                                            <Border x:Name="heavy" DockPanel.Dock="Right" CornerRadius="9" Padding="8,2,8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource DangerSoftBrush}" Visibility="Collapsed">
                                                <TextBlock Text="{Binding HeavyLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}"/>
                                            </Border>
                                            <TextBlock x:Name="star" Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,8,0"
                                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Favorite}" Value="True"><Setter TargetName="star" Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Heavy}" Value="True"><Setter TargetName="heavy" Property="Visibility" Value="Visible"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn IsReadOnly="True" Header="Издатель" Binding="{Binding PublisherName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Размер" SortMemberPath="SizeBytes" Width="190" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold"/>
                                            <Grid Height="{StaticResource BarHeight}" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarFill}"/><ColumnDefinition Width="{Binding BarRest}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" CornerRadius="{StaticResource RBar}" Background="{DynamicResource TrackBrush}"/>
                                                <Border x:Name="bar" CornerRadius="{StaticResource RBar}" Background="{DynamicResource DimBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Big}" Value="True">
                                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource SegFirstBrush}"/>
                                                <Setter TargetName="bar" Property="Effect" Value="{DynamicResource GlowLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Heavy}" Value="True">
                                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource HotBarBrush}"/>
                                                <Setter TargetName="bar" Property="Effect" Value="{DynamicResource GlowHot}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                <ContentControl x:Name="Details" Grid.Column="1" Style="{StaticResource Card}" Margin="18,0,0,0" Width="400" Padding="24,24" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock x:Name="DetailsEmpty" Text="Выберите приложение в таблице" Style="{StaticResource Caption}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"/>
                        <StackPanel x:Name="DetailsBody" Visibility="Collapsed">
                            <Border Width="68" Height="68" CornerRadius="18" BorderThickness="1" HorizontalAlignment="Left"
                                    Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource TileEdgeBrush}" Effect="{DynamicResource GlowLight}">
                                <Grid>
                                    <TextBlock x:Name="DLetter" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="DIcon" Width="44" Height="44"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DName" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,4"/>
                            <TextBlock x:Name="DPublisher" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>

                            <DockPanel Margin="0,22,0,10">
                                <TextBlock x:Name="DShare" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DSize" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Grid Height="{StaticResource BarHeight}">
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="DShareFill" Width="0*"/><ColumnDefinition x:Name="DShareRest" Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="{StaticResource RBar}" Background="{DynamicResource TrackBrush}"/>
                                <Border CornerRadius="{StaticResource RBar}" Background="{DynamicResource HotBarBrush}" Effect="{DynamicResource GlowHot}"/>
                            </Grid>

                            <StackPanel Margin="0,22,0,0">
                                <StackPanel.Resources>
                                    <Style x:Key="K" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Margin" Value="0,12,0,3"/></Style>
                                    <Style x:Key="V" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
                                    <Style TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource LineBrush}"/></Style>
                                </StackPanel.Resources>
                                <Border/>
                                <TextBlock Text="Пакет" Style="{StaticResource K}"/>
                                <TextBlock x:Name="DPackage" Style="{StaticResource V}" FontSize="13"/>
                                <Border/>
                                <TextBlock Text="Версия" Style="{StaticResource K}"/>
                                <TextBlock x:Name="DVersion" Style="{StaticResource V}"/>
                                <Border/>
                                <TextBlock Text="Тип" Style="{StaticResource K}"/>
                                <TextBlock x:Name="DType" Style="{StaticResource V}"/>
                                <Border/>
                            </StackPanel>

                            <Border Margin="0,18,0,20" CornerRadius="{StaticResource RControl}" Padding="14,12" Background="{DynamicResource GlassBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,2,10,0"/>
                                    <TextBlock x:Name="DNote" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>

                            <UniformGrid Columns="3">
                                <Button Content="Удалить" Style="{StaticResource DangerBtn}" Height="46" Padding="8,0" Click="RemoveSelected_Click"/>
                                <Button Content="Папка" Height="46" Padding="8,0" Click="Folder_Click"/>
                                <Button Content="Обновить" Height="46" Padding="8,0" Margin="0" Click="Refresh_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </ContentControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
