<UserControl x:Class="RegKeeper.Modules.StoreAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- header: title and description, the counters on the right -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Приложения" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="AppsFigure" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Занимают" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="SpaceFigure" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Можно освободить" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="FreeFigure" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Приложения Windows" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Приложения из Microsoft Store и встроенные UWP-приложения текущего пользователя. Фреймворки и системные пакеты скрыты и не удаляются."/>
            </StackPanel>
        </DockPanel>
        <!-- what takes the space: the five largest and the rest in one strip -->
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,20,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="SpaceTotal" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                    <TextBlock Text="Что занимает место" Style="{StaticResource Caption}"/>
                </DockPanel>
                <Grid x:Name="Segments" Height="8"/>
                <WrapPanel x:Name="Legend" Margin="0,10,0,-8" TextElement.FontSize="12"/>
            </StackPanel>
        </ContentControl>
        <!-- toolbar: search on the left; the filter and refresh on the right, rarer commands under "⋯" -->
        <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Toolbar}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <CheckBox x:Name="ShowSystem" Content="Системные" Style="{StaticResource Chip}" ToolTip="Показать системные пакеты" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <Button Content="&#xE72C;" Style="{StaticResource IconBtn}" ToolTip="Обновить" AutomationProperties.Name="Обновить" Click="Refresh_Click"/>
                <Button Style="{StaticResource More}" Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Запустить" Tag="&#xE768;" Click="Run_Click"/>
                            <MenuItem Header="Папка" Tag="&#xE838;" Click="Folder_Click"/>
                            <MenuItem Header="Избранное" Tag="&#xE734;" ToolTip="Добавить в избранное или убрать" Click="Fav_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition MaxWidth="420"/></Grid.ColumnDefinitions>
                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged" ToolTip="Поиск по названию, пакету и издателю"/>
            </Grid>
        </DockPanel>
        <!-- table and details side by side; on a narrow window the details hide until "Подробнее..." -->
        <Grid x:Name="Main" SizeChanged="Main_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged" ContextMenuOpening="Grid_ContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MenuCheck" Header="Выбрать" Tag="&#xE73E;" Click="Check_Click"/>
                            <MenuItem x:Name="MenuRemove" Header="Удалить" Tag="&#xE74D;" Click="Remove_Click"/>
                            <MenuItem x:Name="MenuFav" Header="В избранное" Tag="&#xE734;" Click="Fav_Click"/>
                            <MenuItem x:Name="MenuRun" Header="Запустить" Tag="&#xE768;" Click="Run_Click"/>
                            <Separator/>
                            <MenuItem Header="Подробнее..." Tag="&#xE946;" Click="Details_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                        <DataGridTemplateColumn Width="62" CellTemplate="{StaticResource AppIcon}" IsReadOnly="True"/>
                        <!-- favourites carry a filled star before the name, heavy apps a red tag after it -->
                        <DataGridTemplateColumn Header="Название" SortMemberPath="Title" Width="2*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <ContentPresenter x:Name="heavy" DockPanel.Dock="Right" Content="{Binding HeavyLabel}" ContentTemplate="{StaticResource DangerBadge}"
                                                          Margin="8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <TextBlock x:Name="star" Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,8" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Favorite}" Value="True"><Setter TargetName="star" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Heavy}" Value="True"><Setter TargetName="heavy" Property="Visibility" Value="Visible"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn IsReadOnly="True" Header="Издатель" Binding="{Binding PublisherName}" Width="*"/>
                        <DataGridTemplateColumn Header="Размер" SortMemberPath="SizeBytes" Width="130" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeText}"/>
                                        <Grid Width="{StaticResource MiniBarWidth}" Height="{StaticResource BarHeight}" Margin="0,6,0,0" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding BarFill}"/><ColumnDefinition Width="{Binding BarRest}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" CornerRadius="{StaticResource RBar}" Background="{DynamicResource TrackBrush}"/>
                                            <Border x:Name="bar" CornerRadius="{StaticResource RBar}" Background="{DynamicResource DimBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Big}" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource PrimaryBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Heavy}" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource GridEmpty}" Tag="{Binding ElementName=Grid}" Text="Ничего не найдено. Измените запрос или включите «Системные»."/>
                <ContentControl x:Name="Bar" Style="{StaticResource SelectionBar}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BarText" Style="{StaticResource BarCount}"/>
                        <TextBlock Style="{StaticResource Reversible}"><Run Text="&#xE7BA;" FontFamily="{StaticResource Icons}"/> <Run Text="Вернуть можно только из Microsoft Store"/></TextBlock>
                        <Button Content="Удалить" Style="{StaticResource SmallDanger}" Margin="0" Click="Remove_Click"/>
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- the selected app in full -->
            <ContentControl x:Name="Details" Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Width="320" Padding="20" VerticalAlignment="Top">
                <Grid>
                    <TextBlock x:Name="DetailsEmpty" Text="Выберите приложение в таблице" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32"/>
                    <StackPanel x:Name="DetailsBody" Visibility="Collapsed">
                        <Border Width="48" Height="48" CornerRadius="{StaticResource RCard}" BorderThickness="1" HorizontalAlignment="Left"
                                Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource TileEdgeBrush}">
                            <Grid>
                                <TextBlock x:Name="DLetter" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="DIcon" Width="30" Height="30"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,2"/>
                        <TextBlock x:Name="DPublisher" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,16,0,8">
                            <TextBlock x:Name="DShare" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DSize" FontSize="24" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Grid Height="{StaticResource BarHeight}">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DShareFill" Width="0*"/><ColumnDefinition x:Name="DShareRest" Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="{StaticResource RBar}" Background="{DynamicResource TrackBrush}"/>
                            <Border CornerRadius="{StaticResource RBar}" Background="{DynamicResource PrimaryBrush}"/>
                        </Grid>
                        <TextBlock Text="Пакет" Style="{StaticResource Caption}" Margin="0,12,0,2"/>
                        <TextBlock x:Name="DPackage" TextWrapping="Wrap" Style="{StaticResource MonoText}"/>
                        <TextBlock Text="Версия" Style="{StaticResource Caption}" Margin="0,12,0,2"/>
                        <TextBlock x:Name="DVersion" TextWrapping="Wrap"/>
                        <TextBlock Text="Тип" Style="{StaticResource Caption}" Margin="0,12,0,2"/>
                        <TextBlock x:Name="DType" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DNote" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Запустить" Style="{StaticResource Small}" Click="Run_Click"/>
                            <Button Content="Папка" Style="{StaticResource Small}" Margin="0" Click="Folder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
