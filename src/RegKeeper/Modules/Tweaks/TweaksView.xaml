<UserControl x:Class="RegKeeper.Modules.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- header: title and description, "on / total" on the right -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                <TextBlock FontSize="32" FontWeight="Bold" VerticalAlignment="Bottom"><Run x:Name="OnRun"/><Run Text=" / " Foreground="{DynamicResource FaintBrush}"/><Run x:Name="TotalRun" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                <TextBlock Text="включено" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Твики" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Переключите нужное и нажмите «Применить». Тег на карточке показывает, что изменится. Каждое применение можно откатить в Центре отмены."/>
            </StackPanel>
        </DockPanel>
        <!-- categories as segments (added in code), search behind the icon -->
        <DockPanel DockPanel.Dock="Top" Margin="0,16,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Width="290" Visibility="Collapsed" TextChanged="Search_TextChanged" ToolTip="Поиск по названию, описанию и категории"/>
                <Button x:Name="SearchBtn" Content="&#xE721;" Style="{StaticResource IconBtn}" Margin="6,0,0,0" Click="SearchBtn_Click" ToolTip="Поиск" AutomationProperties.Name="Поиск"/>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Left" PreviewMouseWheel="Cats_MouseWheel">
                <Border Style="{StaticResource Segments}">
                    <StackPanel x:Name="Cats" Orientation="Horizontal">
                        <RadioButton x:Name="AllCats" Content="Все" Style="{StaticResource Segment}" Tag="" IsChecked="True" Checked="Cat_Checked"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DockPanel>
        <Grid>
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Cards" Margin="0,0,0,90" SizeChanged="Cards_SizeChanged" ContextMenuOpening="Cards_ContextMenuOpening">
                    <ItemsControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Ключ в редакторе" Tag="&#xE8A7;" Click="Open_Click"/>
                        </ContextMenu>
                    </ItemsControl.ContextMenu>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- a card: name and switch, what it does, category and restart; pending = raised with an edge and a tag -->
                            <Border x:Name="card" Margin="0,0,12,12" Padding="18,16,16,14" CornerRadius="16" BorderThickness="1"
                                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardEdgeBrush}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <CheckBox x:Name="sw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="12,0,0,0"
                                                  IsChecked="{Binding Wanted, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <ContentPresenter Content="{Binding Category}" ContentTemplate="{StaticResource OutlineBadge}" Margin="0,0,6,0"/>
                                        <ContentPresenter Content="{Binding RestartText}" ContentTemplate="{StaticResource Badge}" Margin="0,0,6,0"/>
                                        <Border x:Name="tag" Visibility="Collapsed" Height="{StaticResource TagHeight}" CornerRadius="{StaticResource RTag}" Background="{DynamicResource PrimaryBrush}" Padding="8,0">
                                            <TextBlock x:Name="tagText" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource OnPrimaryBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChecked, ElementName=sw}" Value="True"/>
                                        <Condition Binding="{Binding IsOn}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="sw" Property="Tag" Value="pending"/>
                                    <Setter TargetName="tag" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="tagText" Property="Text" Value="{DynamicResource WillOn}"/>
                                    <Setter TargetName="card" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource PendingEdgeBrush}"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChecked, ElementName=sw}" Value="False"/>
                                        <Condition Binding="{Binding IsOn}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="sw" Property="Tag" Value="pending"/>
                                    <Setter TargetName="tag" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="tagText" Property="Text" Value="{DynamicResource WillOff}"/>
                                    <Setter TargetName="card" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource PendingEdgeBrush}"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Style="{StaticResource GridEmpty}" Tag="{Binding ElementName=Cards}" Text="Ничего не найдено. Измените запрос."/>
            <!-- pending changes: reset to the system state or apply -->
            <ContentControl x:Name="Bar" Style="{StaticResource SelectionBar}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BarText" Style="{StaticResource BarCount}"/>
                    <Button Content="Сбросить" Click="Reset_Click" ToolTip="Вернуть переключатели к текущему состоянию системы"/>
                    <Border Style="{StaticResource DockRule}"/>
                    <Button Content="Применить" Style="{StaticResource Primary}" Margin="0" Click="Apply_Click"/>
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
