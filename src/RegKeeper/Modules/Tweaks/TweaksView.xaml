<UserControl x:Class="RegKeeper.Modules.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Твики" Style="{StaticResource Title}"/>
            <TextBlock Style="{StaticResource Lead}" Text="Отметьте, что включить, снимите, что выключить, и нажмите «Применить». Галочка отражает текущее состояние системы. Каждое применение можно откатить в Центре отмены."/>
            <DockPanel Margin="{StaticResource Toolbar}">
                <TextBlock x:Name="Status" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                <WrapPanel>
                    <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Width="420" Margin="0,0,8,0" TextChanged="Search_TextChanged" ToolTip="Поиск по названию, описанию и категории"/>
                    <Button Content="Применить" Style="{StaticResource Primary}" Click="Apply_Click"/>
                    <Button Content="Сбросить отметки" Click="Reset_Click" ToolTip="Вернуть галочки к текущему состоянию системы"/>
                    <Button Content="Ключ в редакторе" Click="Open_Click"/>
                </WrapPanel>
            </DockPanel>
        </StackPanel>
        <DataGrid x:Name="Grid" MouseDoubleClick="Open_Click" RowHeight="NaN" MinRowHeight="{StaticResource RowHeight}">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,10,0,4"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Wanted, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                <DataGridTextColumn Header="Твик" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Что делает" Binding="{Binding Description}" IsReadOnly="True" Width="3*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Нужно" Binding="{Binding RestartText}" IsReadOnly="True" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
