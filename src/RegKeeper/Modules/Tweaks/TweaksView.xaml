<UserControl x:Class="RegKeeper.Modules.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- header: title and description, the counters on the right -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Включено" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="OnText" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Всего" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TotalText" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Твики" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Переключите нужное и нажмите «Применить». Тег у переключателя показывает, что изменится. Каждое применение можно откатить в Центре отмены."/>
            </StackPanel>
        </DockPanel>
        <!-- toolbar: search on the left, Apply on the right; the rest under "⋯" -->
        <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Toolbar}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <Button Content="Применить" Style="{StaticResource Primary}" Click="Apply_Click"/>
                <Button Style="{StaticResource More}" Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Сбросить отметки" Tag="&#xE7A7;" ToolTip="Вернуть переключатели к текущему состоянию системы" Click="Reset_Click"/>
                            <MenuItem Header="Ключ в редакторе" Tag="&#xE8A7;" Click="Open_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition MaxWidth="420"/></Grid.ColumnDefinitions>
                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged" ToolTip="Поиск по названию, описанию и категории"/>
            </Grid>
        </DockPanel>
        <Grid>
            <DataGrid x:Name="Grid" MouseDoubleClick="Open_Click">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="8,14,0,6"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <!-- the wanted state; a tag says what Apply will change -->
                    <DataGridTemplateColumn Header="Вкл" Width="Auto" MinWidth="130" SortMemberPath="Wanted">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <CheckBox x:Name="sw" Style="{StaticResource Switch}" IsChecked="{Binding Wanted, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Border x:Name="tag" Visibility="Collapsed" Margin="8,0,0,0" Height="{StaticResource TagHeight}" CornerRadius="{StaticResource RTag}" Background="{DynamicResource TagBrush}" Padding="8,0">
                                        <TextBlock x:Name="tagText" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, ElementName=sw}" Value="True"/>
                                    <Condition Binding="{Binding IsOn}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="sw" Property="Tag" Value="pending"/>
                                <Setter TargetName="tag" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="tagText" Property="Text" Value="{DynamicResource WillOn}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, ElementName=sw}" Value="False"/>
                                    <Condition Binding="{Binding IsOn}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="sw" Property="Tag" Value="pending"/>
                                <Setter TargetName="tag" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="tagText" Property="Text" Value="{DynamicResource WillOff}"/>
                            </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Твик" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Что делает" Binding="{Binding Description}" IsReadOnly="True" Width="3*"/>
                    <DataGridTemplateColumn Header="Нужно" Width="Auto" MinWidth="110" SortMemberPath="RestartText">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding RestartText}" ContentTemplate="{StaticResource Badge}" Margin="8,0" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource GridEmpty}" Tag="{Binding ElementName=Grid}" Text="Ничего не найдено. Измените запрос."/>
        </Grid>
    </DockPanel>
</UserControl>
