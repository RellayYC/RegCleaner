<UserControl x:Class="RegKeeper.Modules.RegSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- header: title and description, the counters on the right -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Разделов" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="ScannedText" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Metric}">
                    <StackPanel><TextBlock Text="Найдено" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="FoundText" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                </ContentControl>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Поиск и замена в реестре" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Lead}" Text="Ищет по разделам, именам и данным значений. Замена и удаление найденного откатываются из Центра отмены."/>
                <TextBlock x:Name="Stopped" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed" Text="Поиск остановлен, показано найденное до остановки."/>
            </StackPanel>
        </DockPanel>
        <!-- toolbar: the pattern and Search in one row; marking and the editor under "⋯" -->
        <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Toolbar}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <Button x:Name="SearchBtn" Content="Искать" Style="{StaticResource Primary}" Click="Search_Click"/>
                <Button Style="{StaticResource More}" Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Отметить все" Tag="&#xE73A;" Click="All_Click"/>
                            <MenuItem Header="Снять все" Tag="&#xE739;" Click="None_Click"/>
                            <Separator/>
                            <MenuItem Header="Открыть в редакторе" Tag="&#xE8A7;" Click="Open_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <TextBox x:Name="Pattern" Style="{StaticResource SearchBox}" ToolTip="Что найти" KeyDown="Pattern_KeyDown"/>
        </DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Заменить на" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                <TextBox x:Name="Replacement"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Где искать" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                <TextBox x:Name="Roots" ToolTip="Ключи через ; (например HKLM\SOFTWARE; HKCU)"/>
            </StackPanel>
        </Grid>
        <!-- what to match: chips wrap in a narrow window, buttons never do -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox x:Name="InKeys" Content="Разделы" Style="{StaticResource Chip}" IsChecked="True" Margin="0,0,6,6"/>
            <CheckBox x:Name="InNames" Content="Имена значений" Style="{StaticResource Chip}" IsChecked="True" Margin="0,0,6,6"/>
            <CheckBox x:Name="InData" Content="Данные" Style="{StaticResource Chip}" IsChecked="True" Margin="0,0,18,6"/>
            <CheckBox x:Name="MatchCase" Content="Учитывать регистр" Style="{StaticResource Chip}" Margin="0,0,6,6"/>
            <CheckBox x:Name="WholeWord" Content="Слово целиком" Style="{StaticResource Chip}" Margin="0,0,6,6"/>
            <CheckBox x:Name="IsRegex" Content="Регулярное выражение" Style="{StaticResource Chip}" Margin="0,0,6,6"/>
        </WrapPanel>
        <Grid>
        <DataGrid x:Name="Grid" SelectionMode="Extended" MouseDoubleClick="Open_Click">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                <DataGridTextColumn Header="Где" Binding="{Binding KindText}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Ключ" Binding="{Binding Display}" IsReadOnly="True" Width="3*"/>
                <DataGridTextColumn Header="Совпадение" Binding="{Binding Text}" IsReadOnly="True" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock Style="{StaticResource GridEmpty}" Tag="{Binding ElementName=Grid}" Text="Здесь появится найденное. Введите текст и нажмите «Искать»."/>
            <ContentControl x:Name="Bar" Style="{StaticResource SelectionBar}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BarText" Style="{StaticResource BarCount}"/>
                    <TextBlock Style="{StaticResource Reversible}"><Run Text="&#xE7A7;" FontFamily="{StaticResource Icons}"/> <Run Text="Всё можно вернуть из Центра отмены"/></TextBlock>
                    <Button Content="Заменить" Style="{StaticResource Small}" Click="Replace_Click" ToolTip="Заменить в отмеченных"/>
                    <Button Content="Удалить" Style="{StaticResource SmallDanger}" Margin="0" Click="Delete_Click"/>
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
